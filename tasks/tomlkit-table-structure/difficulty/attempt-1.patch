+def _collect_table_parts(
+    container: Container,
+    path: tuple[Any, ...],
+    out: dict[tuple[Any, ...], list[tuple[Container, Key, Table]]],
+    aots: dict[tuple[Any, ...], int] | None = None,
+) -> None:
+    """Map every logical table path to the tables (parts) rendering it."""
+    if aots is None:
+        aots = {}
+    for k, v in container._body:
+        if k is None:
+            continue
+        p = (*path, k.key)
+        if isinstance(v, AoT):
+            start = aots.get(p, 0)
+            for i, t in enumerate(v.body):
+                out.setdefault((*p, start + i), []).append((container, k, t))
+                _collect_table_parts(t.value, (*p, start + i), out, aots)
+            aots[p] = start + len(v.body)
+        elif isinstance(v, Table):
+            if aots.get(p):
+                # extends the last element of the array of tables
+                p = (*p, aots[p] - 1)
+            out.setdefault(p, []).append((container, k, v))
+            _collect_table_parts(v.value, p, out, aots)
+
+
+def _prune_empty_parts(container: Container) -> None:
+    """Remove emptied header-less parts of tables that other parts define.
+
+    Such a part renders nothing useful, but on its own an empty table renders
+    its header, which would define the table a second time.
+    """
+    changed = True
+    while changed:
+        changed = False
+        parts: dict[tuple[Any, ...], list[tuple[Container, Key, Table]]] = {}
+        _collect_table_parts(container, (), parts)
+        for frags in parts.values():
+            if len(frags) < 2:
+                continue
+            empty = [
+                f
+                for f in frags
+                if not _has_keys(f[2])
+                and not f[2].is_aot_element()
+                and (f[1].is_dotted() or f[2]._is_super_table is not False)
+            ]
+            if not empty or len(empty) == len(frags):
+                continue
+            for owner, _, table in empty:
+                _remove_fragment(owner, table)
+                changed = True
+
