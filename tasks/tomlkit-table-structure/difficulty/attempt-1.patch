+def _can_merge_children(current: Table, item: Table) -> bool:
+    container = current.value
+    for k, v in item.value.body:
+        if k is None:
+            if isinstance(v, (Whitespace, Null)):
+                continue
+            return False
+        if isinstance(v, (Table, AoT)) and k.is_dotted():
+            return False
+        if k not in container._map:
+            if not isinstance(v, (Table, AoT)):
+                return False
+            continue
+        idx = container._map[k]
+        last_idx = idx[-1] if isinstance(idx, tuple) else idx
+        if container._last_index() != last_idx:
+            return False
+        existing = container._body[last_idx][1]
+        if isinstance(existing, AoT):
+            if not (isinstance(v, AoT) or (isinstance(v, Table) and v.is_aot_element())):
+                return False
+        elif isinstance(existing, Table):
+            if not (isinstance(v, Table) and existing.is_super_table() and v.is_super_table()):
+                return False
+            if last_idx and container._body[last_idx][0] is not None and container._body[last_idx][0].is_dotted():
+                return False
+            if not _can_merge_children(existing, v):
+                return False
+        else:
+            return False
+    return True
