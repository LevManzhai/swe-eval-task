+def _relocate_empty_aots(container: Container) -> None:
+    """Move emptied arrays of tables out of header-less parts of tables.
+
+    An emptied array of tables renders as ``key = []``, which needs the scope
+    of its table. A header-less (super) table has none, and rendering the pair
+    as a dotted key in an enclosing scope would define the table a second time
+    if another part of it renders a header. So the pair is moved into the
+    closest part rendering a header.
+    """
+    parts: dict[tuple[Any, ...], list[tuple[Container, Key, Table]]] = {}
+    _collect_table_parts(container, (), parts)
+    path_of = {id(t): p for p, frags in parts.items() for _, _, t in frags}
+
+    def renders_header(key: Key, table: Table) -> bool:
+        return table.is_aot_element() or (
+            not key.is_dotted() and _emits_header(key, table)
+        )
+
+    def has_header_elsewhere(path: tuple[Any, ...], source: Table) -> bool:
+        return any(
+            t is not source and renders_header(k, t) for _, k, t in parts.get(path, [])
+        )
+
+    owner_of = {
+        id(t): (o, k) for frags in parts.values() for o, k, t in frags
+    }
+    table_of = {id(t.value): t for frags in parts.values() for _, _, t in frags}
+
+    def scope_depth(table: Table) -> int:
+        # depth of the nearest ancestor (or self) rendering a header
+        current: Table | None = table
+        while current is not None:
+            o, k = owner_of[id(current)]
+            if renders_header(k, current):
+                return len(path_of[id(current)])
+            current = table_of.get(id(o))
+        return 0
+
+    moves = []
+    for path, frags in parts.items():
+        for _, key, table in frags:
+            if key.is_dotted() or renders_header(key, table):
+                continue
+            empties = [
+                (k, v)
+                for k, v in table.value._body
+                if k is not None and _is_empty_aot(v)
+            ]
+            if not empties:
+                continue
+            depth = scope_depth(table)
+            if not any(
+                has_header_elsewhere(path[:d], table)
+                for d in range(depth + 1, len(path) + 1)
+            ):
+                continue
+            for k, v in empties:
+                moves.append((path, table, k, v))
+    for path, source, leaf, aot in moves:
+        target = None
+        rest: tuple[Any, ...] = ()
+        for d in range(len(path), 0, -1):
+            for _, k, t in parts.get(path[:d], []):
+                if t is not source and renders_header(k, t) and not _contains(t, source.value):
+                    target = t
+                    break
+            if target is not None:
+                rest = path[d:]
+                break
+        if target is None or any(isinstance(r, int) for r in rest):
+            continue
+        _remove_fragment(source.value, aot)
+        dest = target.value
+        for name in rest:
+            sub = None
+            for k, v in dest._body:
+                if k is not None and k.key == name and isinstance(v, Table) and k.is_dotted():
+                    sub = v
+            if sub is None:
+                sub_key = SingleKey(name)
+                sub_key._dotted = True
+                sub = Table(Container(), Trivia(), False, is_super_table=True)
+                dest._raw_append(sub_key, sub)
+            dest = sub.value
+        if leaf not in dest._map:
+            dest._raw_append(leaf, aot)
+
