+def _join(acc: str, piece: str) -> str:
+    """Concatenate a rendered entry, making sure it starts on its own line."""
+    if piece and acc:
+        stripped = acc.rstrip(" \t")
+        if (
+            stripped
+            and not stripped.endswith("\n")
+            and not piece.lstrip(" \t").startswith(("\n", "\r"))
+        ):
+            acc += "\n"
+    return acc + piece
+
