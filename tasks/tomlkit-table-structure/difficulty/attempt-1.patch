+def _renders_table_header(table: Table) -> bool:
+    """Whether a dotted-key table renders a ``[header]`` for any descendant."""
+    for k, v in table.value.body:
+        if isinstance(v, AoT):
+            if v.body:
+                return True
+        elif isinstance(v, Table):
+            if k is not None and k.is_dotted() and v.is_super_table():
+                if _renders_table_header(v):
+                    return True
+            else:
+                return True
+    return False
+
+
+def _is_header_entry(key: Key | None, item: Item) -> bool:
+    """Whether the entry renders as (or under) a ``[header]``, opening a scope
+    that captures every key/value pair rendered after it."""
+    if key is None:
+        return False
+    if isinstance(item, AoT):
+        return bool(item.body)
+    if not isinstance(item, Table):
+        return False
+    return not key.is_dotted() or _renders_table_header(item)
+
+
+def _drop_empty_parts(
+    body: list[tuple[Key | None, Item]],
+) -> list[tuple[Key | None, Item]]:
+    """Leave out emptied header-less parts of a split table: the other parts
+    carry the table."""
+
+    def _droppable(k: Key | None, v: Item) -> bool:
+        return (
+            k is not None
+            and isinstance(v, Table)
+            and (k.is_dotted() or v.is_super_table())
+            and not _has_keys(v)
+        )
+
+    kept: dict[Key, int] = {}
+    for k, v in body:
+        if k is not None and not isinstance(v, Null) and not _droppable(k, v):
+            kept[k] = kept.get(k, 0) + 1
+    if any(k is not None and _droppable(k, v) and kept.get(k) for k, v in body):
+        body = [
+            (k, v)
+            for k, v in body
+            if not (k is not None and _droppable(k, v) and kept.get(k))
+        ]
+    return body
+
+
+def _render_order(
+    body: list[tuple[Key | None, Item]],
+) -> list[tuple[Key | None, Item, str | None]]:
+    """The order to render the entries of a scope in.
+
+    Entries rendered inline (``key = value`` and dotted keys) have to come
+    before the first entry rendering a ``[header]``, or they would end up in the
+    header's table. Documents as parsed are always in this order; it can only
+    be broken by modifications.
+    """
+    body = _drop_empty_parts(body)
+    first_header = None
+    for i, (k, v) in enumerate(body):
+        if _is_header_entry(k, v):
+            first_header = i
+            break
+    if first_header is None:
+        return [(k, v, None) for k, v in body]
+
+    def _split(k: Key | None, v: Item) -> bool:
+        # a dotted-key table rendering headers: its inline part goes with
+        # the inline entries, its headers stay in place
+        return k is not None and isinstance(v, Table) and k.is_dotted()
+
+    late: list[tuple[Key | None, Item, str | None]] = []
+    rest: list[tuple[Key | None, Item, str | None]] = []
+    for k, v in body[first_header:]:
+        if k is None or isinstance(v, Null) or _is_empty_aot(v):
+            rest.append((k, v, None))
+        elif not _is_header_entry(k, v):
+            late.append((k, v, None))
+        elif _split(k, v):
+            late.append((k, v, "inline"))
+            rest.append((k, v, "headers"))
+        else:
+            rest.append((k, v, None))
+    return [(k, v, None) for k, v in body[:first_header]] + late + rest
+
+
+def _has_keys(table: Table) -> bool:
+    return any(
+        k is not None and not isinstance(v, Null) for k, v in table.value._body
+    )
+
+
+def _inline_value(value: Any) -> str:
+    """Render a value in inline form (tables as inline tables, arrays of tables
+    as arrays of inline tables)."""
+    if isinstance(value, (AoT, OutOfOrderAoTProxy)):
+        return "[" + ", ".join(_inline_value(t) for t in value.body) + "]"
+    if isinstance(value, (Table, OutOfOrderTableProxy)):
+        container = value.value if isinstance(value, Table) else None
+        if container is not None:
+            keys = []
+            for k, _ in container._body:
+                if k is not None and k in container._map and k not in keys:
+                    keys.append(k)
+            pairs = [(k, container.item(k)) for k in keys]
+        else:
+            assert isinstance(value, OutOfOrderTableProxy)
+            pairs = [(k, value.item(k)) for k in value._entries()]
+        return (
+            "{"
+            + ", ".join(f"{k.as_string()} = {_inline_value(v)}" for k, v in pairs)
+            + "}"
+        )
+    if isinstance(value, Item):
+        return value.as_string()
+    return str(value)  # pragma: no cover
+
