+        if ch == "\\":
+            pos += 2
+            continue
+        if ch == "[":
+            return -1
+        if ch == "]":
+            return pos if pos - start - 1 <= 999 else -1
+        if pos - start - 1 >= 999:
+            return -1
+        pos += 1
+    return -1
