+++ b/tests/test_conformance.py
@@ -0,0 +1,239 @@
+"""Parsing, round trip and editing conformance with the TOML specification."""
+
+from __future__ import annotations
+
+import datetime
+import sys
+
+from typing import Any
+
+import pytest
+
+import tomlkit
+
+from tomlkit.exceptions import TOMLKitError
+
+
+if sys.version_info >= (3, 11):
+    import tomllib
+else:  # pragma: no cover
+    tomllib = None
+
+needs_tomllib = pytest.mark.skipif(tomllib is None, reason="tomllib is required")
+
+
+def loads(s: str) -> Any:
+    """Parse with a reference parser when there is one, else with tomlkit."""
+    if tomllib is not None:
+        return tomllib.loads(s)
+    return tomlkit.parse(s).unwrap()
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        '[tool.poetry]\nname = "foo"\n\n[[plugins]]\nname = "bar"\n\n'
+        '[tool.other]\na = "b"\n',
+        "[[a]]\n[[b]]\n[[a.b]]\n",
+        "[[fruit]]\nname = 1\n[other]\n[fruit.apple]\nx = 1\n",
+        "[[a.a]]\n[b]\n[a.a.x]\n",
+        "[b]\n[['b'.b.b]]\n",
+        "a = [1979-05-27 , 2]\n",
+        "a = [1979-05-27 07:32:00 , 2]\n",
+        "[a.b.c]\n[a]\na.b = []\n",
+        "a.b = 1\nx = 2\na.c = 3\n",
+    ],
+)
+def test_round_trip(content: str) -> None:
+    doc = tomlkit.parse(content)
+    assert doc.as_string() == content
+    assert doc.unwrap() == loads(content)
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "b.a.a = {}\n[[b.b]]\n[b]\n",
+        "a = 1\na.b = 2\n",
+        "[a]\nb = 1\n[a.b.c]\n",
+        "a = {b = 1, b.c = 2}\n",
+        "a = [\r1]\n",
+        "a = {\rb = 1}\n",
+        'a = """x\\\r"""\n',
+        "[[a]]\n[a]\n",
+        "a = []\n[[a]]\n",
+    ],
+)
+def test_invalid_documents_are_rejected(content: str) -> None:
+    with pytest.raises(TOMLKitError):
+        tomlkit.parse(content).unwrap()
+
+
+def test_exponent_after_zero() -> None:
+    assert tomlkit.parse("a = 0E0\n")["a"] == 0.0
+
+
+def check(doc: tomlkit.TOMLDocument, expected: dict[str, Any]) -> None:
+    text = doc.as_string()
+    assert loads(text) == expected
+    assert doc.unwrap() == expected
+    assert tomlkit.parse(text).unwrap() == expected
+
+
+def test_append_to_array_of_tables_without_trailing_newline() -> None:
+    doc = tomlkit.parse("[[a]]")
+    doc["a"].append({})
+    check(doc, {"a": [{}, {}]})
+
+
+def test_delete_only_child_of_implicit_table() -> None:
+    doc = tomlkit.parse("[a.b]\n")
+    del doc["a"]["b"]
+    check(doc, {"a": {}})
+
+
+def test_delete_only_child_of_dotted_key() -> None:
+    doc = tomlkit.parse("a.b = 1\nc = 2\n")
+    del doc["a"]["b"]
+    check(doc, {"a": {}, "c": 2})
+
+
+def test_array_slice_deletion() -> None:
+    doc = tomlkit.parse("a = [1, 2, 3]\n")
+    del doc["a"][0:0]
+    check(doc, {"a": [1, 2, 3]})
+    del doc["a"][1:]
+    check(doc, {"a": [1]})
+
+
+def test_set_array_of_tables_element_to_a_scalar_raises() -> None:
+    doc = tomlkit.parse("[[a]]\nx = 1\n")
+    with pytest.raises(ValueError):
+        doc["a"][0] = 3
+    check(doc, {"a": [{"x": 1}]})
+
+
+def test_array_of_tables_slice_assignment() -> None:
+    doc = tomlkit.parse("[[a]]\nx = 1\n[[a]]\nx = 2\n")
+    doc["a"][0:1] = [{"y": 1}, {"y": 2}]
+    check(doc, {"a": [{"y": 1}, {"y": 2}, {"x": 2}]})
+
+
+def test_extend_out_of_order_array_of_tables_element() -> None:
+    doc = tomlkit.parse("[[fruit]]\nname = 1\n[other]\n[fruit.apple]\nx = 1\n")
+    fruit = doc["fruit"]
+    fruit[0]["apple"]["y"] = 2
+    fruit.append({"name": 2})
+    check(
+        doc,
+        {
+            "fruit": [{"name": 1, "apple": {"x": 1, "y": 2}}, {"name": 2}],
+            "other": {},
+        },
+    )
+    del fruit[0]
+    check(doc, {"fruit": [{"name": 2}], "other": {}})
+
+
+def test_datetime_with_a_sub_minute_offset() -> None:
+    tz = datetime.timezone(datetime.timedelta(seconds=3725))
+    value = datetime.datetime(2020, 1, 2, 3, 4, 5, tzinfo=tz)
+    doc = tomlkit.document()
+    doc["a"] = value
+    assert loads(doc.as_string())["a"] == value
+
+
+@pytest.mark.parametrize("text", ["a\x00b", "a\x7f"])
+def test_comment_with_control_characters_is_refused(text: str) -> None:
+    doc = tomlkit.parse("a = 1\n")
+    with pytest.raises(ValueError):
+        doc.item("a").comment(text)
+    with pytest.raises(ValueError):
+        tomlkit.comment(text)
+
+
+def test_comment_with_carriage_return() -> None:
+    doc = tomlkit.document()
+    doc.add(tomlkit.comment("x\ry"))
+    check(doc, {})
+
+
+@pytest.mark.parametrize("tail", ['"', "'", '"""', "\\", "\n", "\r", "\x00", "é"])
+@pytest.mark.parametrize("literal", [False, True])
+@pytest.mark.parametrize("multiline", [False, True])
+def test_string_concatenation(tail: str, literal: bool, multiline: bool) -> None:
+    doc = tomlkit.document()
+    doc["a"] = tomlkit.string("x'", literal=False, multiline=multiline)
+    if literal:
+        doc["a"] = tomlkit.string("x", literal=True, multiline=multiline)
+    expected = str(doc["a"]) + tail
+    doc["a"] = doc["a"] + tail
+    assert loads(doc.as_string())["a"].replace("\r\n", "\n") == expected.replace(
+        "\r\n", "\n"
+    )
+
+
+def test_table_under_dotted_key_in_array_of_tables() -> None:
+    doc = tomlkit.parse("[[t]]\nb.a = 5\nc = 1\n")
+    doc["t"][0]["b"]["a"] = {"x": []}
+    check(doc, {"t": [{"b": {"a": {"x": []}}, "c": 1}]})
+
+
+def test_table_under_dotted_key_does_not_capture_following_values() -> None:
+    doc = tomlkit.parse('a.b.c = "x"\nz = 1\n')
+    doc["a"]["b"]["c"] = {"d": 1}
+    check(doc, {"a": {"b": {"c": {"d": 1}}}, "z": 1})
+
+
+def test_table_in_array_becomes_inline() -> None:
+    doc = tomlkit.document()
+    doc["a"] = [1]
+    t = tomlkit.table()
+    t["x"] = 1
+    doc["a"].append(t)
+    check(doc, {"a": [1, {"x": 1}]})
+
+
+def test_inline_table_refuses_comments() -> None:
+    doc = tomlkit.parse("a = {b = 1}\n")
+    with pytest.raises(ValueError):
+        doc["a"].add(tomlkit.comment("x"))
+    doc["a"]["b"] = 2
+    doc["a"].item("b").comment("ignored")
+    check(doc, {"a": {"b": 2}})
+
+
+def test_dotted_append_into_existing_table() -> None:
+    doc = tomlkit.parse('["a.b"]\nx = 1\n')
+    doc.append(tomlkit.key(["a.b", "c"]), 2)
+    check(doc, {"a.b": {"x": 1, "c": 2}})
+    with pytest.raises(TOMLKitError):
+        doc.append(tomlkit.key(["a.b", "c"]), 3)
+    check(doc, {"a.b": {"x": 1, "c": 2}})
+
+
+def test_failed_table_merge_leaves_document_untouched() -> None:
+    doc = tomlkit.document()
+    doc.append(tomlkit.key(["c", "x", "a"]), [])
+    before = doc.as_string()
+    with pytest.raises(TOMLKitError):
+        doc["c"].append("x", {"a": {}, "c": {}})
+    assert doc.as_string() == before
+
+
+def test_emptied_array_of_tables_with_split_parent() -> None:
+    doc = tomlkit.parse("[[t.a]]\n[x]\n[t]\ny = 1\n")
+    doc["t"]["a"].pop()
+    check(doc, {"t": {"a": [], "y": 1}, "x": {}})
+
+
+def test_emptied_array_of_tables_under_array_element() -> None:
+    doc = tomlkit.parse("[[a]]\n[x]\n[[a.b]]\n")
+    doc["a"][0]["b"].pop()
+    check(doc, {"a": [{"b": []}], "x": {}})
+
+
+def test_replace_split_table_by_value() -> None:
+    doc = tomlkit.parse('a.b.c = 1\n[[a.b.d]]\n')
+    doc["a"]["b"] = 0.5
+    check(doc, {"a": {"b": 0.5}})
