index 0000000..7528a09
--- /dev/null
+++ b/tomlkit/_semantics.py
@@ -0,0 +1,185 @@
+"""
+Semantic validation of the key structure of a TOML document.
+
+The parser builds a style-preserving tree, whose shape (super tables,
+out-of-order fragments, dotted keys...) does not map one to one onto the
+TOML data model. The rules about which keys and tables may be defined,
+extended or redefined are therefore checked separately, on the plain
+sequence of headers and key/value pairs, in the order they appear in the
+source. This mirrors the rules of the TOML specification.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+Path = tuple[str, ...]
+
+# A table defined by a ``[header]`` or created by a dotted key (in a later
+# section); it cannot be defined again.
+EXPLICIT_NEST = 1
+# An inline table or array (and everything below it); it cannot be extended.
+FROZEN = 2
+
+
+class _Flags:
+    def __init__(self) -> None:
+        self._flags: dict[str, Any] = {}
+        self._pending: set[tuple[Path, int]] = set()
+
+    def add_pending(self, key: Path, flag: int) -> None:
+        self._pending.add((key, flag))
+
+    def finalize_pending(self) -> None:
+        for key, flag in self._pending:
+            self.set(key, flag, recursive=False)
+        self._pending.clear()
+
+    def unset_all(self, key: Path) -> None:
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return
+            cont = cont[k]["nested"]
+        cont.pop(key[-1], None)
+
+    def set(self, key: Path, flag: int, *, recursive: bool) -> None:
+        cont = self._flags
+        for k in key:
+            if k not in cont:
+                cont[k] = {"flags": set(), "recursive_flags": set(), "nested": {}}
+            last = cont[k]
+            cont = last["nested"]
+        last["recursive_flags" if recursive else "flags"].add(flag)
+
+    def is_(self, key: Path, flag: int) -> bool:
+        if not key:
+            return False
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return False
+            inner = cont[k]
+            if flag in inner["recursive_flags"]:
+                return True
+            cont = inner["nested"]
+        stem = key[-1]
+        if stem in cont:
+            inner = cont[stem]
+            return flag in inner["flags"] or flag in inner["recursive_flags"]
+        return False
+
+
+_VALUE = object()
+
+
+class _Nest:
+    def __init__(self) -> None:
+        self.dict: dict[str, Any] = {}
+
+    def get_or_create_nest(self, key: Path, *, access_lists: bool = True) -> dict:
+        cont: Any = self.dict
+        for k in key:
+            if k not in cont:
+                cont[k] = {}
+            cont = cont[k]
+            if access_lists and isinstance(cont, list):
+                cont = cont[-1]
+            if not isinstance(cont, dict):
+                raise KeyError("There is no nest behind this key")
+        return cont
+
+    def append_nest_to_list(self, key: Path) -> None:
+        cont = self.get_or_create_nest(key[:-1])
+        last = key[-1]
+        if last in cont:
+            lst = cont[last]
+            if not isinstance(lst, list):
+                raise KeyError("An object other than list found behind this key")
+            lst.append({})
+        else:
+            cont[last] = [{}]
+
+
+class SemanticError(Exception):
+    pass
+
+
+class DocumentChecker:
+    """Validates the headers and key/value pairs of a document."""
+
+    def __init__(self) -> None:
+        self._flags = _Flags()
+        self._data = _Nest()
+        self._header: Path = ()
+
+    def table(self, key: Path) -> None:
+        self._flags.finalize_pending()
+        if self._flags.is_(key, EXPLICIT_NEST) or self._flags.is_(key, FROZEN):
+            raise SemanticError(f"Cannot declare {_fmt(key)} twice")
+        self._flags.set(key, EXPLICIT_NEST, recursive=False)
+        try:
+            self._data.get_or_create_nest(key)
+        except KeyError:
+            raise SemanticError(f"Cannot overwrite a value with table {_fmt(key)}")
+        self._header = key
+
+    def array_of_tables(self, key: Path) -> None:
+        self._flags.finalize_pending()
+        if self._flags.is_(key, FROZEN):
+            raise SemanticError(f"Cannot mutate immutable namespace {_fmt(key)}")
+        self._flags.unset_all(key)
+        self._flags.set(key, EXPLICIT_NEST, recursive=False)
+        try:
+            self._data.append_nest_to_list(key)
+        except KeyError:
+            raise SemanticError(f"Cannot overwrite a value with {_fmt(key)}")
+        self._header = key
+
+    def key_value(self, key: Path, frozen: bool) -> None:
+        header = self._header
+        parent, stem = key[:-1], key[-1]
+        abs_parent = header + parent
+        for i in range(1, len(key)):
+            cont_key = header + key[:i]
+            if self._flags.is_(cont_key, EXPLICIT_NEST):
+                raise SemanticError(f"Cannot redefine namespace {_fmt(cont_key)}")
+            self._flags.add_pending(cont_key, EXPLICIT_NEST)
+        if self._flags.is_(abs_parent, FROZEN):
+            raise SemanticError(f"Cannot mutate immutable namespace {_fmt(abs_parent)}")
+        try:
+            nest = self._data.get_or_create_nest(abs_parent)
+        except KeyError:
+            raise SemanticError(f"Cannot overwrite a value at {_fmt(abs_parent)}")
+        if stem in nest:
+            raise SemanticError(f"Cannot overwrite a value at {_fmt(header + key)}")
+        if frozen:
+            self._flags.set(header + key, FROZEN, recursive=True)
+        nest[stem] = _VALUE
+
+
+class InlineTableChecker:
+    """Validates the keys of a single inline table."""
+
+    def __init__(self) -> None:
+        self._flags = _Flags()
+        self._data = _Nest()
+
+    def key_value(self, key: Path, frozen: bool) -> None:
+        parent, stem = key[:-1], key[-1]
+        if self._flags.is_(key, FROZEN):
+            raise SemanticError(f"Cannot mutate immutable namespace {_fmt(key)}")
+        try:
+            nest = self._data.get_or_create_nest(parent, access_lists=False)
+        except KeyError:
+            raise SemanticError(f"Cannot overwrite a value at {_fmt(parent)}")
+        if stem in nest:
+            raise SemanticError(f"Duplicate inline table key {_fmt(key)}")
+        nest[stem] = _VALUE
+        if frozen:
+            self._flags.set(key, FROZEN, recursive=True)
+
+
+def _fmt(key: Path) -> str:
+    return ".".join(key)
