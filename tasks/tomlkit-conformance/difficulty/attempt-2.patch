diff --git a/tests/test_contract.py b/tests/test_contract.py
new file mode 100644
index 0000000..5a2cc57
--- /dev/null
+++ b/tests/test_contract.py
@@ -0,0 +1,194 @@
+"""Parsing, round trip and editing follow the TOML v1.0.0 specification."""
+
+from __future__ import annotations
+
+import datetime
+import sys
+
+from typing import Any
+
+import pytest
+
+import tomlkit
+
+from tomlkit.exceptions import TOMLKitError
+
+
+if sys.version_info >= (3, 11):
+    import tomllib
+else:  # pragma: no cover
+    tomllib = None
+
+needs_tomllib = pytest.mark.skipif(tomllib is None, reason="needs tomllib")
+
+
+def assert_valid(doc: Any) -> str:
+    rendered: str = doc.as_string()
+    reparsed = tomlkit.parse(rendered).unwrap()
+    assert reparsed == doc.unwrap()
+    if tomllib is not None:
+        assert tomllib.loads(rendered) == doc.unwrap()
+    return rendered
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        '[tool.poetry]\nname = "foo"\n\n[[plugins]]\nname = "bar"\n\n'
+        '[tool.other]\na = "b"\n',
+        "[[a]]\n[[b]]\n[a.c]\n",
+        "[[fruits]]\n[[s]]\n[[fruits.s]]\n",
+        "[[c.c]]\n[[b]]\n[[c.c.a]]\n",
+        "[a . b.x]\n[[\"a\".x]]\n",
+        "a = [1979-05-27 07:32:00 , 1979-05-27 ]\n",
+        'a = {b = 1, c = 1979-05-27 07:32:00 }\n',
+        "[[a.x.x]]\n[a]\nx.a = 1\n",
+        "[a.x.y]\n[a]\nx.a = 1\n",
+        "a = 0E5\nb = -0e-1\nc = 1E+2\n",
+    ],
+)
+def test_valid_documents_round_trip(content: str) -> None:
+    doc = tomlkit.parse(content)
+    assert doc.as_string() == content
+    if tomllib is not None:
+        assert doc.unwrap() == tomllib.loads(content)
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "a = +Inf\n",
+        "a = -NaN\n",
+        "a = 1١\n",
+        "a = 1979-05-2٧\n",
+        "[c]\n[x]\n[c.c]\n[c]\n",
+        "a.b = 1\n[[a.x]]\n[a]\n",
+        "[[a.x]]\n[a]\nx.a = 1\n",
+        "a = {b = 1, b.c = 2}\n",
+        "a = [1,\r2]\n",
+        "a = {b = 1,\rc = 2}\n",
+        'a = """\\\n\r"""\n',
+    ],
+)
+def test_invalid_documents_are_rejected(content: str) -> None:
+    with pytest.raises(TOMLKitError):
+        tomlkit.parse(content).unwrap()
+
+
+@needs_tomllib
+def test_split_array_of_tables_is_editable_through_the_table() -> None:
+    doc = tomlkit.parse(
+        "[hooks]\n[[hooks.Stop]]\nm = 1\n[unrelated]\nx = 1\n"
+        "[[hooks.Stop]]\nm = 2\n[hooks.state]\ny = 2\n"
+    )
+    stop = doc["hooks"]["Stop"]
+    stop.append({"m": 3})
+    stop[0] = {"m": 0}
+    del stop[1]
+    assert assert_valid(doc)
+    assert doc.unwrap()["hooks"]["Stop"] == [{"m": 0}, {"m": 3}]
+
+    doc["hooks"]["Stop"] = {"x": 1}
+    assert_valid(doc)
+    assert doc.unwrap()["hooks"] == {"Stop": {"x": 1}, "state": {"y": 2}}
+
+
+@needs_tomllib
+def test_emptied_array_of_tables_in_split_table() -> None:
+    doc = tomlkit.parse(
+        "[[tool.poetry.source]]\nname = 'a'\n[tool.poetry]\nname = 'x'\n"
+    )
+    doc["tool"]["poetry"]["source"].clear()
+    assert_valid(doc)
+    assert doc.unwrap() == {"tool": {"poetry": {"source": [], "name": "x"}}}
+
+
+@needs_tomllib
+def test_emptied_dotted_table_keeps_the_table() -> None:
+    doc = tomlkit.parse("x.y.z = 1\nx.w = 2\n[q]\n")
+    del doc["x"]["y"]["z"]
+    assert_valid(doc)
+    assert doc.unwrap() == {"x": {"y": {}, "w": 2}, "q": {}}
+
+
+@needs_tomllib
+def test_table_values_under_dotted_keys() -> None:
+    doc = tomlkit.parse("x.y.z = 1\nx.w = 2\n[q]\n")
+    doc["x"]["y"] = [{"a": 1}, {"b": 2}]
+    doc["x"]["v"] = {"c": {"d": 1}}
+    doc["z"] = 1
+    assert_valid(doc)
+
+    doc = tomlkit.parse("t = {y = 1, z.w = 2}\n")
+    doc["t"]["z"]["q"] = {"a": [{"b": 1}]}
+    doc["t"]["z"] = tomlkit.aot()
+    assert_valid(doc)
+
+
+@needs_tomllib
+def test_dotted_key_assignment_extends_existing_table() -> None:
+    doc = tomlkit.parse("[a]\nb = 1\n")
+    doc[tomlkit.key(["a", "c"])] = 2
+    doc[tomlkit.key(["a", "c"])] = 3
+    assert_valid(doc)
+    assert doc.unwrap() == {"a": {"b": 1, "c": 3}}
+
+
+@needs_tomllib
+def test_array_edits_with_comments() -> None:
+    doc = tomlkit.parse("b = [1, 2, # c\n  3]\nc = [\n+nan\n#c\n]\n")
+    del doc["b"][2]
+    doc["b"].insert(2, 4)
+    doc["c"].append(1)
+    del doc["b"][1:None:-1]
+    rendered = doc.as_string()
+    assert tomllib.loads(rendered)["b"] == [4]
+    assert tomllib.loads(rendered)["c"][1] == 1
+
+
+@needs_tomllib
+def test_tables_in_inline_context_are_written_inline() -> None:
+    doc = tomlkit.document()
+    aot = tomlkit.aot()
+    aot.append({"y": 1})
+    doc["x"] = [{"c": aot, "x": 1}, [{"b": tomlkit.aot()}]]
+    arr = tomlkit.array()
+    arr.append(tomlkit.table())
+    doc["y"] = arr
+    assert_valid(doc)
+
+
+def test_string_concatenation_stays_valid() -> None:
+    s = tomlkit.string("a", literal=True) + "'"
+    assert tomlkit.parse(f"v = {s.as_string()}")["v"] == "a'"
+    s = tomlkit.string("a''", literal=True, multiline=True) + "'"
+    assert tomlkit.parse(f"v = {s.as_string()}")["v"] == "a'''"
+    s = tomlkit.string('q"', multiline=True) + '""'
+    assert tomlkit.parse(f"v = {s.as_string()}")["v"] == 'q"""'
+    s = tomlkit.item("x") + 'y"z'
+    assert tomlkit.parse(f"v = {s.as_string()}")["v"] == 'xy"z'
+
+
+def test_datetime_with_sub_minute_offset() -> None:
+    tz = datetime.timezone(datetime.timedelta(hours=5, minutes=30, seconds=7))
+    value = datetime.datetime(2020, 1, 2, 3, 4, 5, tzinfo=tz)
+    doc = tomlkit.document()
+    doc["a"] = value
+    assert tomlkit.parse(doc.as_string())["a"] == value
+
+
+@pytest.mark.parametrize("text", ["a\x00b", "a\x7fb"])
+def test_comments_reject_control_characters(text: str) -> None:
+    with pytest.raises(ValueError):
+        tomlkit.comment(text)
+    with pytest.raises(ValueError):
+        tomlkit.item(1).comment(text)
+
+
+def test_inline_table_rejects_comments() -> None:
+    table = tomlkit.inline_table()
+    with pytest.raises(ValueError):
+        table.add(tomlkit.comment("x"))
+    doc = tomlkit.parse("a = {x = 1, y.z = 2}\n")
+    doc["a"]["y"].comment("ignored")
+    assert tomlkit.parse(doc.as_string()) == {"a": {"x": 1, "y": {"z": 2}}}
diff --git a/tomlkit/_namespace.py b/tomlkit/_namespace.py
new file mode 100644
index 0000000..06fa124
--- /dev/null
+++ b/tomlkit/_namespace.py
@@ -0,0 +1,191 @@
+"""
+Tracking of the table/key namespace of a TOML document while it is parsed.
+
+The rules mirror the TOML specification: a table may only be defined once
+(by a ``[header]`` or by dotted keys), a key may only be assigned once, inline
+tables and arrays are immutable once defined, and an array of tables may be
+extended by further ``[[header]]`` declarations only.
+
+The document model built by the parser is optimised for preserving the layout
+of the source, which makes it hard to check these rules on it. They are
+checked here instead, in the order the declarations appear in the source.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+_FROZEN = 0
+_EXPLICIT_NEST = 1
+
+
+class _Flags:
+    def __init__(self) -> None:
+        self._flags: dict[str, Any] = {}
+        self._pending: set[tuple[tuple[str, ...], int]] = set()
+
+    def add_pending(self, key: tuple[str, ...], flag: int) -> None:
+        self._pending.add((key, flag))
+
+    def finalize_pending(self) -> None:
+        for key, flag in self._pending:
+            self.set(key, flag, recursive=False)
+        self._pending.clear()
+
+    def unset_all(self, key: tuple[str, ...]) -> None:
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return
+            cont = cont[k]["nested"]
+        cont.pop(key[-1], None)
+
+    def set(self, key: tuple[str, ...], flag: int, *, recursive: bool) -> None:
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                cont[k] = {"flags": set(), "recursive_flags": set(), "nested": {}}
+            cont = cont[k]["nested"]
+        stem = key[-1]
+        if stem not in cont:
+            cont[stem] = {"flags": set(), "recursive_flags": set(), "nested": {}}
+        cont[stem]["recursive_flags" if recursive else "flags"].add(flag)
+
+    def is_(self, key: tuple[str, ...], flag: int) -> bool:
+        if not key:
+            return False
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return False
+            inner = cont[k]
+            if flag in inner["recursive_flags"]:
+                return True
+            cont = inner["nested"]
+        stem = key[-1]
+        if stem in cont:
+            inner = cont[stem]
+            return flag in inner["flags"] or flag in inner["recursive_flags"]
+        return False
+
+
+_VALUE = object()
+
+
+class _NestedDict:
+    def __init__(self) -> None:
+        self.dict: dict[str, Any] = {}
+
+    def get_or_create_nest(
+        self, key: tuple[str, ...], *, access_lists: bool = True
+    ) -> dict[str, Any]:
+        cont: Any = self.dict
+        for k in key:
+            if k not in cont:
+                cont[k] = {}
+            cont = cont[k]
+            if access_lists and isinstance(cont, list):
+                cont = cont[-1]
+            if not isinstance(cont, dict):
+                raise KeyError("There is no nest behind this key")
+        return cont  # type: ignore[no-any-return]
+
+    def append_nest_to_list(self, key: tuple[str, ...]) -> None:
+        cont = self.get_or_create_nest(key[:-1])
+        last = key[-1]
+        if last in cont:
+            lst = cont[last]
+            if not isinstance(lst, list):
+                raise KeyError("An object other than list found behind this key")
+            lst.append({})
+        else:
+            cont[last] = [{}]
+
+
+class NamespaceError(Exception):
+    pass
+
+
+class DocumentNamespace:
+    """Checks the declarations of a document, in source order."""
+
+    def __init__(self) -> None:
+        self._flags = _Flags()
+        self._data = _NestedDict()
+        self._header: tuple[str, ...] = ()
+
+    def table(self, key: tuple[str, ...]) -> None:
+        self._flags.finalize_pending()
+        if self._flags.is_(key, _EXPLICIT_NEST) or self._flags.is_(key, _FROZEN):
+            raise NamespaceError(f"Cannot declare {'.'.join(key)} twice")
+        self._flags.set(key, _EXPLICIT_NEST, recursive=False)
+        try:
+            self._data.get_or_create_nest(key)
+        except KeyError:
+            raise NamespaceError("Cannot overwrite a value") from None
+        self._header = key
+
+    def array_of_tables(self, key: tuple[str, ...]) -> None:
+        self._flags.finalize_pending()
+        if self._flags.is_(key, _FROZEN):
+            raise NamespaceError(f"Cannot mutate immutable namespace {'.'.join(key)}")
+        self._flags.unset_all(key)
+        self._flags.set(key, _EXPLICIT_NEST, recursive=False)
+        try:
+            self._data.append_nest_to_list(key)
+        except KeyError:
+            raise NamespaceError("Cannot overwrite a value") from None
+        self._header = key
+
+    def key_value(self, key: tuple[str, ...], frozen: bool) -> None:
+        header = self._header
+        parent, stem = key[:-1], key[-1]
+        abs_parent = header + parent
+
+        for i in range(1, len(key)):
+            cont_key = header + key[:i]
+            if self._flags.is_(cont_key, _EXPLICIT_NEST):
+                raise NamespaceError(
+                    f"Cannot redefine namespace {'.'.join(cont_key)}"
+                )
+            self._flags.add_pending(cont_key, _EXPLICIT_NEST)
+
+        if self._flags.is_(abs_parent, _FROZEN):
+            raise NamespaceError(
+                f"Cannot mutate immutable namespace {'.'.join(abs_parent)}"
+            )
+
+        try:
+            nest = self._data.get_or_create_nest(abs_parent)
+        except KeyError:
+            raise NamespaceError("Cannot overwrite a value") from None
+        if stem in nest:
+            raise NamespaceError("Cannot overwrite a value")
+        if frozen:
+            self._flags.set(header + key, _FROZEN, recursive=True)
+        nest[stem] = _VALUE
+
+
+class InlineNamespace:
+    """Checks the keys of a single inline table."""
+
+    def __init__(self) -> None:
+        self._flags = _Flags()
+        self._data = _NestedDict()
+
+    def key_value(self, key: tuple[str, ...], frozen: bool) -> None:
+        parent, stem = key[:-1], key[-1]
+        if self._flags.is_(key, _FROZEN):
+            raise NamespaceError(
+                f"Cannot mutate immutable namespace {'.'.join(key)}"
+            )
+        try:
+            nest = self._data.get_or_create_nest(parent, access_lists=False)
+        except KeyError:
+            raise NamespaceError("Cannot overwrite a value") from None
+        if stem in nest:
+            raise NamespaceError(f"Duplicate inline table key {stem}")
+        nest[stem] = _VALUE
+        if frozen:
+            self._flags.set(key, _FROZEN, recursive=True)
