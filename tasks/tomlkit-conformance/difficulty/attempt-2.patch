+    def _extend_last(self, owner: Table | None, key: Key, table: Table) -> None:
+        self._extensions.append((owner, key, table))
+        element = self._real_last()
+        temp = Container(True)
+        parts: list[Table] = [element, *(t for _, _, t in self._extensions)]
