+class _AoTExtension(Item):
+    """
+    A placeholder for sub-tables of the last element of an array of tables
+    that were declared after other tables, as ``[a.sub]`` in::
+
+        [[a]]
+        [b]
+        [a.sub]
+
+    The sub-tables belong to the element (that is where they are read and
+    edited), but are rendered at the position of the placeholder as long as
+    they can be, so the document keeps its layout.
+    """
+
+    def __init__(self, key: Key, aot: AoT, element: Table, tables: list[Item]):
+        super().__init__(Trivia(trail=""))
+        self.key = key
+        self.aot = aot
+        self.element = element
+        self.tables = tables
+
+    @property
+    def discriminant(self) -> int:
+        return -1
+
+    @property
+    def value(self) -> None:
+        return None
+
+    def unwrap(self) -> None:
+        return None
+
+    def as_string(self) -> str:
+        return ""
+
+    def _getstate(self, protocol: int = 3) -> tuple[Any, ...]:
+        return self.key, self.aot, self.element, self.tables
+
+    def live_entries(self, container: Container) -> list[tuple[Key, Item]]:
+        """The sub-tables still to be rendered at this placeholder."""
+        idx = container._map.get(self.key)
+        if not isinstance(idx, int) or container._body[idx][1] is not self.aot:
+            return []
+        if not self.aot.body or self.aot.body[-1] is not self.element:
+            # the sub-tables would extend another element
+            return []
+        entries = []
+        for table in self.tables:
+            for k, v in self.element.value.body:
+                if v is table and k is not None:
+                    entries.append((k, v))
+                    break
+        return entries
+
+
+def _detached(container: Container) -> set[int]:
+    """The ids of the sub-tables rendered by the placeholders of a container
+    tree instead of by their parent element."""
+    found: set[int] = set()
+
+    def walk(c: Container) -> None:
+        for k, v in c._body:
+            if isinstance(v, _AoTExtension):
+                found.update(id(t) for _, t in v.live_entries(c))
+            elif isinstance(v, Table):
+                walk(v.value)
+            elif isinstance(v, AoT):
+                for t in v.body:
+                    walk(t.value)
+
+    walk(container)
+    return found
+
+
+class _AoTFragments(AoT):
+    """
+    An array of tables whose elements are declared in several out-of-order
+    parts of the same table. It presents the elements as one array, and
+    forwards every change to the part that holds the element concerned.
+    """
+
+    def __init__(self, fragments: list[tuple[Table | None, Key, AoT]]) -> None:
+        self._fragments = fragments
+        # sub-tables of the last element declared in later parts
+        self._extensions: list[tuple[Table | None, Key, Table]] = []
+        super().__init__(
+            [t for _, _, aot in fragments for t in aot.body], parsed=True
+        )
+        self._ready = True
+
+    def _real_last(self) -> Table:
+        for _, _, aot in reversed(self._fragments):
+            if aot.body:
+                return aot.body[-1]
+        raise IndexError("empty array of tables")
