+    in_quotes = False
+    for i, c in enumerate(line):
+        if c == '"':
+            in_quotes = not in_quotes
+        elif not in_quotes:
+            if c == ';':
+                parts.append(line[start:i])
+                start = i + 1
+            elif c == ':':
