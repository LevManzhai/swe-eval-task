+def _split_content_line(line):
+    """Splits a content line into the name (with its parameters) and the
+    value, at the first colon that is not inside a quoted parameter value."""
+    in_quotes = False
+    for i, c in enumerate(line):
+        if c == '"':
+            in_quotes = not in_quotes
+        elif c == ':' and not in_quotes:
+            return line[:i], line[i + 1:]
+    raise ValueError("invalid content line: " + line)
+
+
+def _split_params(name):
+    """Splits the name part of a content line on semicolons that are not
+    inside quoted parameter values."""
+    parts = []
+    current = []
+    in_quotes = False
+    for c in name:
+        if c == '"':
+            in_quotes = not in_quotes
+            current.append(c)
+        elif c == ';' and not in_quotes:
+            parts.append(''.join(current))
+            current = []
+        else:
+            current.append(c)
+    parts.append(''.join(current))
+    return parts
+
+
+def _unquote(value):
+    if len(value) >= 2 and value[0] == value[-1] == '"':
+        return value[1:-1]
+    return value
