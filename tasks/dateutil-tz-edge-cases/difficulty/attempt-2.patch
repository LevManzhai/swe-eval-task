+def _numweeks(year, wkst):
+    """
+    Returns the number of weeks in ``year``, where weeks start on ``wkst``
+    and week number 1 is the first week with at least 4 days in the year.
+    """
+    yearlen = 365 + calendar.isleap(year)
+    yearweekday = calendar.weekday(year, 1, 1) if 1 <= year <= 9999 else (
+        (datetime.date(1, 1, 1).weekday() +
+         (year - 1) * 365 + (year - 1) // 4 - (year - 1) // 100 +
+         (year - 1) // 400) % 7)
+    no1wkst = (7 - yearweekday + wkst) % 7
+    if no1wkst >= 4:
+        wyearlen = yearlen + (yearweekday - wkst) % 7
+    else:
+        wyearlen = yearlen - no1wkst
+    div, mod = divmod(wyearlen, 7)
+    return div + mod // 4
+
