+def _unwrap_brackets(text: str) -> str:
+    """Remove one pair of square brackets enclosing the whole of ``text``,
+    like ``[fast|slow]``. Text such as ``[A] [B]``, where the first bracket
+    closes before the end, is returned unchanged.
+    """
+    if not (text.startswith("[") and text.endswith("]")):
+        return text
+
+    depth = 0
+
+    for index, char in enumerate(text):
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+
+            if depth == 0 and index != len(text) - 1:
+                return text
+
+    if depth != 0:
+        return text
+
+    return text[1:-1]
+
