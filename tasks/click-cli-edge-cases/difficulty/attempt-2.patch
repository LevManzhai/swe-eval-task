+def _default_str(value: t.Any) -> str:
+    """Convert a default value to the string shown in help text.
+
+    ``bytes`` are converted with :func:`repr`, which gives the same text as
+    :class:`str` but does not warn or fail when Python runs with ``-b`` or
+    ``-bb``.
