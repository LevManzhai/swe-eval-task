+def _is_bracketed(text: str) -> bool:
+    """Whether ``text`` is entirely enclosed in one pair of square brackets,
+    like ``[a|b]``, but not ``[a]|[b]``.
+    """
+    if len(text) < 2 or text[0] != "[" or text[-1] != "]":
+        return False
+
+    depth = 0
+
+    for i, ch in enumerate(text):
+        if ch == "[":
+            depth += 1
+        elif ch == "]":
+            depth -= 1
+
+            if depth == 0 and i != len(text) - 1:
+                return False
+
+    return depth == 0
+
