+async def _run_to_completion(coro: Awaitable[Any]) -> Any:
+    """
+    Await ``coro`` in a task of its own, so that cancelling the caller does not
+    interrupt it: the caller still sees the cancellation, but the work goes on
+    until it is done.
+    """
+    task = asyncio.ensure_future(coro)
+    _BACKGROUND_TASKS.add(task)
+    task.add_done_callback(_background_task_done)
+    return await asyncio.shield(task)
+
+
+def _force_close_connection(connection) -> None:
+    """Close a connection's socket without suspending."""
+    try:
+        close = getattr(connection, "_close", None)
+        if close is not None:
+            close()
+    except Exception:
+        pass
+
+
+def _background_task_done(task: "asyncio.Task") -> None:
+    _BACKGROUND_TASKS.discard(task)
+    if not task.cancelled():
+        # Retrieve the exception so that a failure nobody waits for any more
+        # does not end up as "Task exception was never retrieved".
+        task.exception()
+
