+# controls and non-ASCII code points for the WHATWG URL Standard; the
+# percent-encoded octets of reserved characters are kept. "\\" is still
+# percent-encoded, as it is in every path.
+_OPAQUE_PATH_SAFE = " !\"$&'()*+,/:;<=>@[]^`{|}"
+OPAQUE_PATH_REQUOTER = _Quoter(safe=_OPAQUE_PATH_SAFE, protected=_OPAQUE_PATH_SAFE)
+OPAQUE_PATH_QUOTER = _Quoter(safe=_OPAQUE_PATH_SAFE, requote=False)
 PATH_QUOTER = _Quoter(safe="@:", protected="/+", requote=False)
 PATH_REQUOTER = _Quoter(safe="@:", protected=":/@!$&'()*+,;=")
 QUERY_QUOTER = _Quoter(safe="?/:@", protected="=+&;", qs=True, requote=False)
 QUERY_REQUOTER = _Quoter(safe="?/:@", protected="=+&;", qs=True)
+# RFC 3986 section 2.2: RFC 3986 mode keeps every percent-encoded reserved
+# character of the query.
+QUERY_REQUOTER_RFC = _Quoter(safe="?/:@", protected="?/:@!$'()*,=+&;", qs=True)
 QUERY_PART_QUOTER = _Quoter(safe="?/:@", qs=True, requote=False)
 FRAGMENT_QUOTER = _Quoter(safe="?/:@", requote=False)
-FRAGMENT_REQUOTER = _Quoter(safe="?/:@")
+# Percent-encoded reserved characters are kept, RFC 3986 section 2.2; the
+# WHATWG URL Standard keeps every percent-encoded octet of the fragment.
+FRAGMENT_REQUOTER = _Quoter(safe="?/:@", protected=":/?@!$&'()*+,;=")
 
 UNQUOTER = _Unquoter()
 PATH_SAFE_UNQUOTER = _Unquoter(ignore="/%")
@@ -32,3 +49,34 @@ def human_quote(s: str | None, unsafe: str) -> str | None:
     if s.isprintable():
         return s
     return "".join(c if c.isprintable() else quote(c) for c in s)
+
+
+# A "%" that does not start a percent-encoded octet.
+_LONE_PERCENT_RE = re.compile(r"%(?![0-9A-Fa-f]{2})")
+_PCT_ESCAPE_RE = re.compile(r"%[0-9A-Fa-f]{2}")
+
+
+def requote_keep_percent(quoter: _Quoter, val: str) -> str:
+    """Requote val with quoter, keeping each "%" that starts no escape.
+
+    The WHATWG URL Standard leaves such a "%" as it is, as browsers do:
+    "/foo%2zbar" stays "/foo%2zbar" instead of becoming "/foo%252zbar".
+    An escape right after a kept "%", or one character after it, is kept
+    too, only uppercased, so that decoding it cannot form a new escape
+    with that "%": "%%41b" is not "%Ab" and "%2%41" is not "%2A".
+    """
+    if "%" not in val or _LONE_PERCENT_RE.search(val) is None:
+        return quoter(val)
+    pieces = _LONE_PERCENT_RE.split(val)
+    out = [quoter(pieces[0])]
+    for piece in pieces[1:]:
+        out.append("%")
+        # An escape within the two characters after the kept "%" is kept,
+        # "%2%41" is not "%2A".
+        start = piece.find("%", 0, 2)
+        if start != -1 and (m := _PCT_ESCAPE_RE.match(piece, start)) is not None:
+            out.append(quoter(piece[:start]))
+            out.append(m[0].upper())
+            piece = piece[start + 3 :]
+        out.append(quoter(piece))
+    return "".join(out)
