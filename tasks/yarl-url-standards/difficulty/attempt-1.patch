+import re
 from urllib.parse import quote
 
 from ._quoting import _Quoter, _Unquoter
 
 QUOTER = _Quoter(requote=False)
 REQUOTER = _Quoter()
+# The userinfo keeps percent-encoded sub-delims, RFC 3986 section 2.2; the
+# RFC 3986 mode one also keeps ":", which the password may have.
+USERINFO_REQUOTER = _Quoter(protected="!$&'()*+,;=")
+USERINFO_REQUOTER_RFC = _Quoter(safe=":", protected="!$&'()*+,;=:")
