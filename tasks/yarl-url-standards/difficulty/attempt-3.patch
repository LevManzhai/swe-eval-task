+    if "%" not in value or _INVALID_PCT_RE.search(value) is None:
+        return requoter(value)  # type: ignore[no-any-return]
+    parts = _INVALID_PCT_RE.split(value)
+    ret = [requoter(parts[0])]
+    for part in parts[1:]:
+        part = requoter(part)
