+
+
+def _transfer_limiter_token(
+    limiter: BaseCapacityLimiter, old_borrower: object, new_borrower: object
+) -> bool:
+    """
+    Atomically move a borrowed token from one borrower to another.
+
+    :return: ``True`` if the token was transferred, ``False`` if not
+
+    """
+    from .._core._synchronization import CapacityLimiterAdapter
+
+    if isinstance(limiter, CapacityLimiterAdapter):
+        limiter = limiter._limiter
+
+    if isinstance(limiter, CapacityLimiter) and old_borrower in limiter._borrowers:
+        limiter._borrowers.remove(old_borrower)
+        limiter._borrowers.add(new_borrower)
+        return True
+
+    return False
+
+
+def _release_limiter_token(limiter: BaseCapacityLimiter, borrower: object) -> None:
+    try:
+        limiter.release_on_behalf_of(borrower)
+    except RuntimeError:
+        pass
+
