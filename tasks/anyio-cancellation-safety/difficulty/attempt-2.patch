+    """
+    Run ``func`` in a worker thread, making sure that the resource it returns is
+    cleaned up with ``cleanup`` if the result never reaches the caller (for example
+    because the calling task was cancelled).
+
+    """
+    lock = threading.Lock()
+    results: list[T_Result] = []
+    abandoned = False
+
+    def wrapper() -> T_Result:
+        result = func(*args)
+        with lock:
+            if not abandoned:
+                results.append(result)
+                return result
+
+        # The caller has given up on the result, so release the resource right away
+        try:
+            cleanup(result)
+        except BaseException:
+            pass
+
+        return result
+
+    try:
+        retval = await to_thread.run_sync(wrapper, limiter=limiter)
+    except BaseException:
+        with lock:
+            abandoned = True
+            leftovers = list(results)
+            results.clear()
+
+        for leftover in leftovers:
+            try:
+                cleanup(leftover)
+            except BaseException:
+                pass
+
+        raise
+
+    return retval
+
