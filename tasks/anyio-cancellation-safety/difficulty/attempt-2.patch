+class _CancelSafeAsyncGenerator(AsyncGenerator[T, S]):
+    """
+    Wraps an async generator so that it can't silently misbehave after having been
+    cancelled.
+
+    An async generator is finalized as soon as an exception (including a cancellation
+    exception) propagates out of it, after which it would just signal the end of
+    iteration as if it had been exhausted. Instead, if a cancellation exception
+    propagates from the generator, any further use of this wrapper raises
+    :exc:`~anyio.BrokenResourceError`. Cancellation that is pending when the generator
+    is resumed is raised without touching the generator, leaving it intact.
