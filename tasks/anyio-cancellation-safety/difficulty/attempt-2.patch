+
+    def __init__(self, agen: AsyncGenerator[T, S]) -> None:
+        self._agen = agen
+        self._broken = False
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._agen, name)
+
+    def __repr__(self) -> str:
+        return f"<{self.__class__.__name__} wrapping {self._agen!r}>"
+
+    def __aiter__(self) -> _CancelSafeAsyncGenerator[T, S]:
+        return self
+
+    async def _resume(
