+class _AbandonedWorkerThread:
+    """Borrower of a capacity limiter token held by an abandoned worker thread."""
+
+    def __repr__(self) -> str:
+        return f"<abandoned worker thread at {id(self):x}>"
+
+
+class _AbandonedThreadTracker:
+    """
+    Keeps a capacity limiter token borrowed on behalf of a worker thread that was
+    abandoned by its host task, until the thread actually finishes.
+
+    All methods must be called in the event loop thread.
+
+    """
+
+    def __init__(self, limiter: BaseCapacityLimiter):
+        if isinstance(limiter, CapacityLimiterAdapter):
+            limiter = limiter._limiter
+
+        self._limiter = limiter
+        self._thread_done = False
+        self._borrower: _AbandonedWorkerThread | None = None
+
+    def thread_finished(self) -> None:
+        self._thread_done = True
+        if self._borrower is not None:
+            borrower, self._borrower = self._borrower, None
+            assert isinstance(self._limiter, CapacityLimiter)
+            try:
+                self._limiter.release_on_behalf_of(borrower)
+            except RuntimeError:
+                pass
+
+    def abandon(self) -> bool:
+        """
+        Transfer the current task's token to the worker thread.
+
+        :return: ``True`` if the token was transferred, ``False`` if the caller should
+            release it as usual
+
+        """
+        if self._thread_done or not isinstance(self._limiter, CapacityLimiter):
+            return False
+
+        task = current_task()
+        if task not in self._limiter._borrowers:
+            return False
+
+        self._borrower = _AbandonedWorkerThread()
+        # Swap the borrowers without releasing the token in between
+        self._limiter._borrowers.discard(task)
+        self._limiter._borrowers.add(self._borrower)
+        return True
+
+
