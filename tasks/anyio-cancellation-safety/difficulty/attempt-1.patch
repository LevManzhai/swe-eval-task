+async def _aclose_all(resources: Iterable[AsyncResource]) -> None:
+    """
+    Close all the given resources, even if closing one of them raises an exception
+    (such as a cancellation exception).
+
+    The first exception raised is re-raised after every resource has been closed.
+
+    """
+    first_exc: BaseException | None = None
+    for resource in resources:
+        try:
+            await resource.aclose()
+        except BaseException as exc:
+            if first_exc is None:
+                first_exc = exc
+
+    if first_exc is not None:
+        try:
+            raise first_exc
+        finally:
+            del first_exc
+
