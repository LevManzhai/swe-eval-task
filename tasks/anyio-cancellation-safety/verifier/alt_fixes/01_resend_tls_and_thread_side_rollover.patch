+def _claim(future: Future[Any]) -> bool:
+    """
+    Atomically move ``future`` out of the cancellable state before completing it.
+
+    A ``concurrent.futures.Future`` can be cancelled from another thread at any
+    moment while it is pending, and ``set_result()`` does not notice a
+    cancellation that has not been processed yet. Marking it as running first
+    closes that window: after this returns ``True``, ``cancel()`` is refused.
+    """
+    return future.set_running_or_notify_cancel()
+
+
