diff --git a/test/protocols/graphql/graphql-subscription-reset.node.test.ts b/test/protocols/graphql/graphql-subscription-reset.node.test.ts
new file mode 100644
index 0000000..c5db42d
--- /dev/null
+++ b/test/protocols/graphql/graphql-subscription-reset.node.test.ts
@@ -0,0 +1,161 @@
+// @vitest-environment node
+import { setupServer } from 'msw/node'
+import { graphql } from 'msw/graphql'
+import {
+  createClient,
+  type DisposableGraphQLClient,
+} from '../../support/graphql-client'
+import { gql } from '../../support/graphql'
+
+const api = graphql.link('https://api.example.com/graphql')
+const otherApi = graphql.link('https://api.example.com/graphql')
+
+const initialResolver = vi.fn(({ subscription }) => {
+  subscription.publish({ data: { tick: 1 } })
+})
+const initialHandler = api.subscription('OnTick', initialResolver)
+
+const server = setupServer(initialHandler)
+let client: DisposableGraphQLClient
+
+const query = gql`
+  subscription OnTick {
+    tick
+  }
+`
+
+function next(c: DisposableGraphQLClient = client) {
+  const iterator = c.iterate({ query })
+  return iterator.next().finally(() => iterator.return?.())
+}
+
+beforeAll(() => {
+  server.listen()
+  client = createClient({ url: 'wss://api.example.com/graphql', lazy: false })
+})
+
+afterEach(() => {
+  server.resetHandlers()
+  vi.restoreAllMocks()
+})
+
+afterAll(async () => {
+  await client.dispose()
+  server.close()
+})
+
+test('first', async () => {
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 1 } },
+  })
+})
+
+test('second (after reset)', async () => {
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 1 } },
+  })
+})
+
+const runtimeResolver = vi.fn(({ subscription }) => {
+  subscription.publish({ data: { tick: 2 } })
+})
+const runtimeHandler = otherApi.subscription('OnTick', runtimeResolver)
+
+test('runtime handler from another link takes precedence', async () => {
+  server.use(runtimeHandler)
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 2 } },
+  })
+})
+
+test('runtime handler does not leak after reset', async () => {
+  runtimeResolver.mockClear()
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 1 } },
+  })
+  expect(runtimeResolver).not.toHaveBeenCalled()
+})
+
+test('reset with new handlers removes the initial ones', async () => {
+  initialResolver.mockClear()
+  const replacement = otherApi.subscription('OnTick', ({ subscription }) => {
+    subscription.publish({ data: { tick: 3 } })
+  })
+  server.resetHandlers(replacement)
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 3 } },
+  })
+  expect(initialResolver).not.toHaveBeenCalled()
+  // Restore the original initial handlers for the following tests.
+  server.resetHandlers(initialHandler)
+})
+
+test('once handlers match again after reset, finalize runs on reset', async () => {
+  const cleanup = vi.fn()
+  const onceResolver = vi.fn(({ subscription, finalize }) => {
+    finalize(cleanup)
+    subscription.publish({ data: { tick: 4 } })
+  })
+  const onceHandler = api.subscription('OnTick', onceResolver, { once: true })
+  server.use(onceHandler)
+  const iterator = client.iterate({ query })
+  await expect(iterator.next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 4 } },
+  })
+  server.resetHandlers()
+  await vi.waitFor(() => expect(cleanup).toHaveBeenCalledOnce())
+  iterator.return?.()
+
+  server.use(onceHandler)
+  await expect(next()).resolves.toEqual({
+    done: false,
+    value: { data: { tick: 4 } },
+  })
+  expect(onceResolver).toHaveBeenCalledTimes(2)
+  server.resetHandlers()
+})
+
+test('finalize runs on every reset', async () => {
+  for (let i = 0; i < 2; i++) {
+    const cleanup = vi.fn()
+    server.use(
+      api.subscription('OnTick', ({ subscription, finalize }) => {
+        finalize(cleanup)
+        subscription.publish({ data: { tick: 5 } })
+      }),
+    )
+    const iterator = client.iterate({ query })
+    await expect(iterator.next()).resolves.toEqual({
+      done: false,
+      value: { data: { tick: 5 } },
+    })
+    server.resetHandlers()
+    await vi.waitFor(() => expect(cleanup).toHaveBeenCalledOnce())
+    iterator.return?.()
+  }
+})
+
+test('reset to empty removes everything', async () => {
+  vi.spyOn(console, 'warn').mockImplementation(() => {})
+  initialResolver.mockClear()
+  server.resetHandlers(otherApi.subscription('Other', () => {}))
+  const iterator = client.iterate({ query })
+  const pending = iterator.next()
+  await vi.waitFor(() =>
+    expect(console.warn).toHaveBeenCalledWith(
+      expect.stringContaining(
+        'Intercepted a GraphQL subscription "OnTick" to "wss://api.example.com/graphql" that has no matching subscription handler',
+      ),
+    ),
+  )
+  expect(initialResolver).not.toHaveBeenCalled()
+  iterator.return?.()
+  pending.catch(() => {})
+  server.resetHandlers(initialHandler)
+})
