+def _parse_content_length(content_length: str) -> int | None:
+    """
+    Parses the value of a Content-Length header field.
+
+    Content-Length = 1*DIGIT (RFC 9110, Section 8.6). A list of identical
+    values (e.g. ``42, 42``, as produced by repeated fields) is accepted as
+    that value. Returns ``None`` when the value is not valid, and raises
+    :class:`~urllib3.exceptions.InvalidHeader` when it contains differing
+    values.
+    """
+    values = [v.strip(" \t") for v in content_length.split(",")]
+    values = [v for v in values if v]
+    if not values or not all(_CONTENT_LENGTH_RE.fullmatch(v) for v in values):
+        return None
+    # Compare without leading zeros to avoid converting huge strings.
+    normalized = {v.lstrip("0") or "0" for v in values}
+    if len(normalized) > 1:
+        raise InvalidHeader(
+            "Content-Length contained multiple "
+            "unmatching values (%s)" % content_length
+        )
+    value = normalized.pop()
+    try:
+        return int(value)
+    except ValueError:  # Too many digits to be converted.
+        return None
+
