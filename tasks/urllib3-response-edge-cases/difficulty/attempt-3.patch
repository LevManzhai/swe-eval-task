+    """Normalize all field values of ``headers`` in place."""
+    for vals in headers._container.values():
+        for i in range(1, len(vals)):
+            value = vals[i]
+            if isinstance(value, str):
+                normalized = normalize_field_value(value)
+                if normalized != value:
+                    vals[i] = normalized
+
+
+def _normalize_httplib_message(message: httplib.HTTPMessage) -> None:
+    """Normalize all field values of an ``http.client.HTTPMessage`` in place."""
+    raw_headers = getattr(message, "_headers", None)
+    if not isinstance(raw_headers, list):
+        return
+    for i, item in enumerate(raw_headers):
+        try:
+            name, value = item
+        except (TypeError, ValueError):
+            continue
+        if isinstance(value, str):
+            normalized = normalize_field_value(value)
+            if normalized != value:
