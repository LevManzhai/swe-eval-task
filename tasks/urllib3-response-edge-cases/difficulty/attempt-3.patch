+_TYPE_ORIGIN = typing.Tuple[str, typing.Optional[str], typing.Optional[int]]
+
+
+def _url_origin(url: str) -> _TYPE_ORIGIN | None:
+    """
+    Returns the origin (scheme, host, port) of an absolute URL, with the
+    default port of the scheme filled in. ``None`` if it can't be parsed.
+    """
+    try:
+        parsed = parse_url(url)
+    except LocationParseError:
+        return None
+    scheme = (parsed.scheme or "http").lower()
+    host = _normalize_host(parsed.host, scheme=scheme)
+    if host is not None:
+        host = host.lower()
+    port = parsed.port if parsed.port is not None else port_by_scheme.get(scheme)
+    return scheme, host, port
+
+
+def _is_same_origin(origin: _TYPE_ORIGIN | None, location: str) -> bool:
+    """
+    Whether ``location`` (a URL reference, possibly relative) resolves to the
+    given origin.
+    """
+    if origin is None:
+        return False
+    try:
+        split = urlsplit(location)
+    except ValueError:
+        return False
+    if not split.scheme and not split.netloc:
+        # A relative reference stays on the same origin.
+        return True
+    if not split.scheme:
+        # A network-path reference keeps the scheme.
+        location = f"{origin[0]}:{location}"
+    return _url_origin(location) == origin
+
