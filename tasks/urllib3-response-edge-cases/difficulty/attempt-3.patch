+def normalize_field_value(value: str) -> str:
+    """
+    Normalize a field value received from the wire as RFC 9110 and RFC 9112
+    require from a recipient: each obsolete line folding is replaced with a
+    single SP, CR, LF, NUL and the other control characters a field value
+    can't contain are replaced with SP and leading and trailing whitespace
+    is removed.
+    """
+    if not isinstance(value, str):
+        return value
+    value = _OBS_FOLD_RE.sub(" ", value)
+    value = _INVALID_FIELD_VALUE_CHARS_RE.sub(" ", value)
+    return value.strip(" \t")
+
+
