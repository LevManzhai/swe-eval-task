+    def _grouped(self):
+        """
+        Return the content as a list of (interval, value) pairs sorted by key,
+        with exactly one pair for each distinct value.
+        """
+        if self._groups is None:
+            hashable = {}
+            unhashable = []
+            groups = []
+
+            for atomic, value in self._pieces.values():
+                group = None
+                try:
+                    group = hashable.get(value)
+                except TypeError:
+                    for candidate in unhashable:
+                        if candidate[0] == value:
+                            group = candidate
+                            break
+                    if group is None:
+                        group = (value, [])
+                        unhashable.append(group)
+                        groups.append(group)
+                else:
+                    if group is None:
+                        group = (value, [])
+                        hashable[value] = group
+                        groups.append(group)
+                group[1].append(atomic)
+
+            self._groups = [(Interval(*atomics), v) for v, atomics in groups]
+        return self._groups
+
+    def _find_piece(self, value):
+        """
+        Return the (atomic interval, value) pair whose interval contains given
+        single value, or None.
+        """
+        index = self._pieces.bisect_right((value, False)) - 1
+        if index >= 0:
+            piece = self._pieces.peekitem(index)[1]
+            if value in piece[0]:
+                return piece
+        return None
+
+    def _overlapping(self, atomic):
+        """
+        Return the list of (sort key, atomic interval, value) of the stored
+        pieces that overlap given atomic interval.
+        """
+        pieces = self._pieces
+        start = max(pieces.bisect_right(_sortkey(atomic)) - 1, 0)
+
+        found = []
+        for key in pieces.islice(start):
+            interval, value = pieces[key]
+            if atomic.upper < interval.lower:
+                break
+            if interval.overlaps(atomic):
+                found.append((key, interval, value))
+        return found
+
+    def _remove(self, atomic):
+        """
+        Remove given atomic interval from the stored pieces.
+
+        :return: True if something was removed.
+        """
+        found = self._overlapping(atomic)
+        for key, interval, value in found:
+            del self._pieces[key]
+            for remaining in interval - atomic:
+                self._pieces[_sortkey(remaining)] = (remaining, value)
+        return len(found) > 0
+
+    def _insert(self, atomic, value):
+        """
+        Store given atomic interval, assuming it does not overlap any stored
+        piece. It is merged with its neighbours when they hold the same value.
+        """
+        pieces = self._pieces
+        index = pieces.bisect_left(_sortkey(atomic))
+
+        for neighbour in (index, index - 1):
+            if 0 <= neighbour < len(pieces):
+                key, (interval, v) = pieces.peekitem(neighbour)
+                if value == v:
+                    merged = interval | atomic
+                    if merged.atomic:
+                        del pieces[key]
+                        atomic, value = merged, v
+
+        pieces[_sortkey(atomic)] = (atomic, value)
