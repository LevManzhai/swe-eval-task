+    def _grouped(self):
+        """
+        Return the content as a list of (interval, value) pairs sorted by key,
+        with exactly one pair for each distinct value.
+        """
+        groups = []
+        for atomic, value in self._pieces:
+            for group in groups:
+                if group[0] == value:
+                    group[1].append(atomic)
+                    break
+            else:
+                groups.append((value, [atomic]))
+        return [(self._klass(*atomics), v) for v, atomics in groups]
+
+    def _find_piece(self, value):
+        index = bisect_right(self._keys, (value, False)) - 1
+        if index >= 0:
+            piece = self._pieces[index]
+            if value in piece[0]:
+                return piece
+        return None
+
+    def _overlapping(self, atomic):
+        """
+        Return the indexes of the stored pieces that overlap given atomic interval.
+        """
+        index = max(bisect_right(self._keys, _sortkey(atomic)) - 1, 0)
+        found = []
+        while index < len(self._pieces):
+            interval = self._pieces[index][0]
+            if atomic.upper < interval.lower:
+                break
+            if interval.overlaps(atomic):
+                found.append(index)
+            index += 1
+        return found
+
+    def _remove(self, atomic):
+        found = self._overlapping(atomic)
+        if len(found) == 0:
+            return False
+
+        keys, pieces = [], []
+        for index in found:
+            interval, value = self._pieces[index]
+            for remaining in interval - atomic:
+                keys.append(_sortkey(remaining))
+                pieces.append((remaining, value))
+
+        self._keys[found[0] : found[-1] + 1] = keys
+        self._pieces[found[0] : found[-1] + 1] = pieces
+        return True
+
+    def _insert(self, atomic, value):
+        key = _sortkey(atomic)
+        index = bisect_left(self._keys, key)
+        self._keys.insert(index, key)
