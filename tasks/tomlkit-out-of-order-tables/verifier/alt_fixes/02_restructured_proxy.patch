-                            break
-                    else:
-                        self._tables[0][key] = value
-            else:
-                self._tables[0][key] = value
+            target = None
+            if not _is_table_or_aot(value):
+                # A plain value goes to the first part that already holds plain
+                # values, else to the first concrete part (never give a
+                # header-less super part a header of its own).
+                target = next(
+                    (
+                        t
+                        for t in self._tables
+                        if any(not _is_table_or_aot(v) for _, v in t.items())
+                    ),
+                    None,
+                ) or next((t for t in self._tables if not t.is_super_table()), None)
+            if target is None:
+                target = self._tables[0]
+            target[key] = value
+            index = next(i for i, t in enumerate(self._tables) if t is target)
+            self._tables_map[_key] = [index]
         else:
             self._container[key] = value
 
diff --git a/tomlkit/items.py b/tomlkit/items.py
