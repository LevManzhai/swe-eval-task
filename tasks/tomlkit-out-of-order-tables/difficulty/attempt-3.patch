+    def __init__(self, sources: list[_Source], parent: _SplitView | None = None):
+        Item.__init__(self, Trivia(trail=""))
+        self._sources = sources
+        self._parent = parent
+        self._parsed = True
+        key = sources[0][1]
+        self.name = key.key
+        self._build()
+
+    def _entries(self) -> list[_Entry]:
+        return [
+            e for e in _resolve_sources(self._sources) if isinstance(e[2], (AoT, Table))
+        ]
+
+    def _groups(self) -> list[tuple[AoT, int, Table, list[_Entry]]]:
+        """``(array, index in it, element, extensions)`` for every element."""
+        groups: list[tuple[AoT, int, Table, list[_Entry]]] = []
+        for entry in self._entries():
+            item = entry[2]
+            if isinstance(item, AoT):
+                for i, table in enumerate(item.body):
+                    groups.append((item, i, table, []))
+            elif groups:
+                groups[-1][3].append(entry)
