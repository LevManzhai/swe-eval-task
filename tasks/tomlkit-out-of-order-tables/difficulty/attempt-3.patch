+                elements.append(
+                    OutOfOrderTableProxy(
+                        None,
+                        None,
+                        _sources=[(aot, self._sources[0][1], table)]
+                        + [(o, k, t) for o, k, t in extensions],
+                        _parent=self,
+                    )
+                )
+            else:
+                elements.append(table)
+        self._body = elements
+        list.clear(self)
+        list.extend(self, elements)
+
+    def _prune(self) -> None:
+        """Drop the arrays left empty, keeping at least one."""
+        arrays = [e for e in self._entries() if isinstance(e[2], AoT)]
