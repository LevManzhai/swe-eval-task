+class SplitAoTProxy(AoT):
+    """An array of tables written in several non-contiguous parts.
+
+    The parts are either arrays of tables (``[[a]]`` headers) or super tables
+    that extend the element defined last before them (``[a.b]`` after
+    ``[[a]]`` and some other table). The proxy presents them as one array, the
+    elements extended later being presented as :class:`OutOfOrderTableProxy`.
+    Changes are made in the parts themselves.
+    """
