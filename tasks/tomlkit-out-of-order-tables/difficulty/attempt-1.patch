+        self.name = first.name if first is not None else None
+        self._sync_list()
+
+    def _groups(self) -> list[list[tuple[Key, Table]]]:
+        groups: list[list[tuple[Key, Table]]] = []
+        for k, piece in self._pieces_fn():
+            if isinstance(piece, AoT):
+                for table in piece.body:
+                    groups.append([(k, table)])
+            elif isinstance(piece, Table):
