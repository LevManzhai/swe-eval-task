@@ -1891,3 +1891,70 @@ def test_emptied_array_of_tables_is_relative_to_the_nearest_header() -> None:
     doc["t"]["u"]["a"].pop()
 
     assert doc.as_string() == "[t]\nu.a = []\n"
+
+
+def test_table_split_by_aot_round_trips() -> None:
+    content = """\
+[tool.poetry]
+name = "foo"
+
+[[plugins]]
+name = "bar"
+
+[tool.other]
+a = "b"
+"""
+    doc = parse(content)
+    assert doc.as_string() == content
+    assert doc.unwrap() == {
+        "tool": {"poetry": {"name": "foo"}, "other": {"a": "b"}},
+        "plugins": [{"name": "bar"}],
+    }
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "[c.c.a]\n\n[c]\nb = 0\nc.c = 3\n",
+        "[a.c.b]\n[c.b]\n[a]\nc.c = 9\n",
+        "[[b.c]]\n[x]\n[b.c.b]\n[[b.c]]\n",
+        "[[c.a]]\n[b.c]\n[c.a.b]\na = 4\n",
+        "[b.a]\n[[b.c]]\n[b]\n[b.c.a]\n[[b.c]]\n",
+    ],
+)
+def test_valid_split_tables_are_accepted(content: str) -> None:
+    tomllib = pytest.importorskip("tomllib")
+
+    doc = parse(content)
+    assert doc.unwrap() == tomllib.loads(content)
+    assert doc.as_string() == content
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "b.a = [1, 2]\n[[b.b]]\n[b]\n",
+        "[a]\nx = 1\n[b]\n[a]\n",
+        "[a.b]\n[c]\n[a]\nb.c = 1\n",
+    ],
+)
+def test_invalid_split_tables_are_rejected(content: str) -> None:
+    with pytest.raises(TOMLKitError):
+        parse(content).unwrap()
+
+
+def test_edit_split_table_through_proxy() -> None:
+    tomllib = pytest.importorskip("tomllib")
+
+    content = "[a.b]\nx = 1\n[c]\n[a.d]\ny = 2\n"
+    doc = parse(content)
+    table = doc["a"]
+    table["z"] = 3
+    table["b"]["x"] = 5
+    del table["d"]
+    table.update({"e": {"f": 1}})
+    assert table.pop("z") == 3
+    table["w"] = 4
+    expected = {"a": {"b": {"x": 5}, "e": {"f": 1}, "w": 4}, "c": {}}
+    assert doc.unwrap() == expected
+    assert tomllib.loads(doc.as_string()) == expected
