+def _pieces(container: Container, key: Key) -> list[tuple[Key, Item]]:
+    """The body entries holding ``key`` in ``container``, in document order."""
+    idx = container._map.get(key)
+    if idx is None:
+        return []
+    if not isinstance(idx, tuple):
+        idx = (idx,)
+    pieces = []
+    for i in idx:
+        k, v = container._body[i]
+        assert k is not None
+        pieces.append((k, v))
+    return pieces
+
+
+def _as_key(key: Key | str) -> Key:
+    return key if isinstance(key, Key) else SingleKey(key)
+
+
+def _is_table_like(value: Any) -> bool:
+    return isinstance(value, (Table, AoT, OutOfOrderTableProxy))
+
+
+def _split_view(
+    pieces: list[tuple[Key, Item]],
+    pieces_fn: Any,
+    setter: Any,
+    deleter: Any = None,
+) -> Any:
+    """The object standing for a key whose value is split into several pieces.
+
+    ``pieces_fn`` returns the current pieces (they are looked up again on every
+    access, so the view never goes stale), ``setter`` replaces the whole value.
+    """
+    if any(isinstance(v, AoT) for _, v in pieces):
+        return SplitAoT(pieces_fn, setter)
+    if all(isinstance(v, Table) for _, v in pieces):
+        return OutOfOrderTableProxy(fragments=pieces_fn, deleter=deleter)
+    # Two plain values (or a value and a table) under the same key
+    raise KeyAlreadyPresent(pieces[0][0])
+
+
+def _resolve(
+    pieces: list[tuple[Key, Item]], pieces_fn: Any, setter: Any, deleter: Any
+) -> Any:
+    """The user-facing value of a key, given its pieces."""
+    if len(pieces) == 1:
+        item = pieces[0][1]
+        if item.is_boolean():
+            return item.value
+        return item
+    return _split_view(pieces, pieces_fn, setter, deleter)
+
+
+def _can_merge_in_place(current: Table, item: Table) -> bool:
+    """Whether the children of super table ``item`` can be merged into
+    ``current`` without mixing up arrays of tables and (parts of) tables."""
+    for k, v in item.value.body:
+        if k is None:
+            continue
+        pieces = _pieces(current.value, k)
+        if not pieces:
+            continue
+        existing = pieces[-1][1]
+        if isinstance(v, AoT) or any(isinstance(p, AoT) for _, p in pieces):
+            return False
+        if isinstance(v, Table) and isinstance(existing, Table):
+            if not _can_merge_in_place(existing, v):
+                return False
+    return True
+
+
+def _is_dotted_table(key: Key, table: Item) -> bool:
+    """Whether ``table`` is written with dotted keys (``key.x = 1``)."""
+    return isinstance(table, Table) and key.is_dotted()
+
+
+def _render_inline(key: str, value: Item) -> str:
+    """Render a table or array of tables as an inline ``key = value``."""
+    from tomlkit.items import Array
+
+    inline = _item(value.unwrap(), _parent=Array([], Trivia()))
+    trivia = value.trivia if isinstance(value, Table) else Trivia()
+    return f"{decode(key)} = {inline.as_string()}{trivia.trail or chr(10)}"
+
+
+def _is_redundant_piece(container: Container, key: Key, item: Item) -> bool:
+    """Whether ``item`` is an emptied dotted-key part of a table that has
+    other parts in ``container``: those already define the table, so this
+    one must not be written as ``key = {}``."""
+    return (
+        isinstance(item, Table)
+        and key.is_dotted()
