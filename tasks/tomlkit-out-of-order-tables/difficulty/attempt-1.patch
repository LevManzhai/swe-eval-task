+
+    def _finalize_pending(self) -> None:
+        for ns in self._pending:
+            ns.explicit = True
+        self._pending.clear()
+
+    def _resolve(
+        self, path: tuple[str, ...], create: bool
+    ) -> tuple[_Namespace | None, str | None]:
+        """Walk ``path`` (descending into the last element of arrays of tables).
+
+        Returns the table found at the end of the path, or an error message.
+        """
+        ns = self._root
+        for part in path:
+            if ns.frozen:
+                return None, "Cannot mutate an immutable namespace"
+            child = ns.nested.get(part)
+            if child is None:
+                if not create:
+                    return None, None
+                child = _Namespace("table")
+                ns.nested[part] = child
+            if child.kind == "aot":
+                assert child.last is not None
+                child = child.last
+            elif child.kind != "table":
+                return None, "Cannot overwrite a value"
+            ns = child
+        if ns.frozen:
+            return None, "Cannot mutate an immutable namespace"
+        return ns, None
+
+    def header(self, path: tuple[str, ...], is_aot: bool) -> str | None:
+        self._finalize_pending()
+        parent, error = self._resolve(path[:-1], create=True)
+        if error is not None:
+            return error
+        assert parent is not None
+        name = path[-1]
+        existing = parent.nested.get(name)
+        if is_aot:
+            if existing is None:
+                existing = _Namespace("aot")
+                parent.nested[name] = existing
+            elif existing.kind != "aot":
+                return f'Cannot redefine "{".".join(path)}" as an array of tables'
+            element = _Namespace("table")
+            element.explicit = True
+            existing.last = element
+            return None
+
+        if existing is None:
+            existing = _Namespace("table")
+            parent.nested[name] = existing
+        elif existing.kind != "table":
+            if existing.kind == "aot":
+                return f'Cannot redefine array of tables "{".".join(path)}"'
+            return "Cannot overwrite a value"
+        elif existing.explicit or existing.frozen:
+            return f'Redefinition of an existing table "{".".join(path)}"'
+        existing.explicit = True
+        return None
+
+    def key_value(
+        self, header: tuple[str, ...], key: tuple[str, ...], value: Item
+    ) -> str | None:
+        ns, error = self._resolve(header, create=True)
+        if error is not None:
+            return error
+        assert ns is not None
+        for part in key[:-1]:
+            child = ns.nested.get(part)
+            if child is None:
+                child = _Namespace("table")
+                ns.nested[part] = child
+                self._pending.append(child)
+            elif child.kind != "table":
+                if child.kind == "aot":
+                    return "Cannot redefine an array of tables with a dotted key"
+                return "Cannot overwrite a value"
+            elif child.frozen:
+                return "Cannot mutate an immutable namespace"
+            elif child.explicit:
+                return "Redefinition of an existing table"
+            else:
+                self._pending.append(child)
+            ns = child
+        if key[-1] in ns.nested:
+            return f'Key "{".".join(key)}" already exists'
+        leaf = _Namespace("value")
+        if isinstance(value, (InlineTable, Array)):
+            leaf.frozen = True
+        ns.nested[key[-1]] = leaf
+        return None
