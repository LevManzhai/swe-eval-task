+            isinstance(container._map.get(key), tuple)
+            or getattr(item, "_emptied_part", False)
+        )
+        and not _has_keyed_children(item)
+    )
+
+
+def _has_keyed_children(table: Table) -> bool:
+    return any(k is not None for k, _ in table.value.body)
+
+
+def _holds_plain_values(table: Table) -> bool:
+    return any(
+        k is not None and not isinstance(v, (Table, AoT, Null))
+        for k, v in table.value.body
+    )
+
+
 class OutOfOrderTableProxy(_CustomDict):  # type: ignore[type-arg]
+    """
+    A dict-like view of a table that is defined in several parts (fragments)
+    of the document, e.g.::
+
+        [a.b]
+        x = 1
+
+        [c]
+
+        [a.d]
+        y = 2
