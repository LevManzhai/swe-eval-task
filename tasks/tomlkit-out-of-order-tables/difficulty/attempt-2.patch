+class _SemanticChecker:
+    """Tracks which keys and tables a document defines, in document order.
+
+    This mirrors the rules the TOML specification places on defining tables
+    and keys (the same bookkeeping the standard library's ``tomllib`` does):
+    a table may only be declared once, dotted keys may not reopen a table
+    declared with a header (nor vice versa), inline tables and arrays are
+    immutable, and a key may not be defined twice. It is independent of the
+    document model, which makes it reliable for tables that are split into
+    several non-contiguous parts.
+    """
+
+    _FROZEN = 0
+    _EXPLICIT_NEST = 1
+    _VALUE = object()
+
+    def __init__(self) -> None:
+        self._flags: dict[str, Any] = {}
+        self._pending: list[tuple[tuple[str, ...], int]] = []
+        self._data: dict[str, Any] = {}
+        self.error: str | None = None
+
+    # Flags bookkeeping
+    @staticmethod
+    def _new_node() -> dict[str, Any]:
+        return {"flags": set(), "recursive_flags": set(), "nested": {}}
+
+    def _finalize_pending(self) -> None:
+        for key, flag in self._pending:
+            self._set(key, flag, recursive=False)
+        self._pending.clear()
+
+    def _unset_all(self, key: tuple[str, ...]) -> None:
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return
+            cont = cont[k]["nested"]
+        cont.pop(key[-1], None)
+
+    def _set(self, key: tuple[str, ...], flag: int, *, recursive: bool) -> None:
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                cont[k] = self._new_node()
+            cont = cont[k]["nested"]
+        if key[-1] not in cont:
+            cont[key[-1]] = self._new_node()
+        cont[key[-1]]["recursive_flags" if recursive else "flags"].add(flag)
+
+    def _is(self, key: tuple[str, ...], flag: int) -> bool:
+        if not key:
+            return False
+        cont = self._flags
+        for k in key[:-1]:
+            if k not in cont:
+                return False
+            inner = cont[k]
+            if flag in inner["recursive_flags"]:
+                return True
+            cont = inner["nested"]
+        if key[-1] in cont:
+            inner = cont[key[-1]]
+            return flag in inner["flags"] or flag in inner["recursive_flags"]
+        return False
+
+    # Data skeleton bookkeeping
+    def _get_or_create_nest(self, key: tuple[str, ...]) -> dict[str, Any] | None:
+        cont: Any = self._data
+        for k in key:
+            if k not in cont:
+                cont[k] = {}
+            cont = cont[k]
+            if isinstance(cont, list):
+                cont = cont[-1]
+            if not isinstance(cont, dict):
+                return None
+        return cont
+
+    def _fail(self, msg: str) -> None:
+        if self.error is None:
+            self.error = msg
+
+    # Events
+    def table(self, key: tuple[str, ...]) -> None:
+        if self.error is not None:
+            return
+        self._finalize_pending()
+        name = ".".join(key)
+        if self._is(key, self._EXPLICIT_NEST) or self._is(key, self._FROZEN):
+            return self._fail(f'Cannot declare table "{name}" twice')
+        self._set(key, self._EXPLICIT_NEST, recursive=False)
+        if self._get_or_create_nest(key) is None:
+            return self._fail(f'Cannot overwrite a value with table "{name}"')
+
+    def array_of_tables(self, key: tuple[str, ...]) -> None:
+        if self.error is not None:
+            return
+        self._finalize_pending()
+        name = ".".join(key)
+        if self._is(key, self._FROZEN):
+            return self._fail(f'Cannot extend immutable array "{name}"')
+        self._unset_all(key)
+        self._set(key, self._EXPLICIT_NEST, recursive=False)
+        cont = self._get_or_create_nest(key[:-1])
+        if cont is None:
+            return self._fail(f'Cannot overwrite a value with table "{name}"')
+        last = key[-1]
+        if last in cont:
+            if not isinstance(cont[last], list):
+                return self._fail(f'Cannot overwrite a value with table "{name}"')
+            cont[last].append({})
+        else:
+            cont[last] = [{}]
+
+    def key_value(
+        self, header: tuple[str, ...], key: tuple[str, ...], is_container: bool
+    ) -> None:
+        if self.error is not None:
+            return
+        parent, stem = key[:-1], key[-1]
+        abs_parent = header + parent
+        for i in range(1, len(key)):
+            cont_key = header + key[:i]
+            if self._is(cont_key, self._EXPLICIT_NEST):
+                return self._fail(
+                    f'Cannot redefine table "{".".join(cont_key)}" with a dotted key'
+                )
+            self._pending.append((cont_key, self._EXPLICIT_NEST))
+        name = ".".join(header + key)
+        if self._is(abs_parent, self._FROZEN):
+            return self._fail(f'Cannot add key "{name}" to an immutable value')
+        nest = self._get_or_create_nest(abs_parent)
+        if nest is None or stem in nest:
+            return self._fail(f'Cannot overwrite value "{name}"')
+        if is_container:
+            self._set(header + key, self._FROZEN, recursive=True)
+        nest[stem] = self._VALUE
