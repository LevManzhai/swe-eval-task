+
+def test_edit_split_table_through_proxy() -> None:
+    content = """\
+a.c.a = 1
+
+[a.b]
+x = 1
+
+[other]
+
+[a.d]
+y = 2
+"""
+    doc = parse(content)
+    a = doc["a"]
+    a["w"] = 3
