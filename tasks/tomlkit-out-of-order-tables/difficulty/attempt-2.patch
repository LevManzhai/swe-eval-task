+def test_table_split_by_array_of_tables_round_trips() -> None:
+    content = """\
+[tool.poetry]
+name = "foo"
+
+[[plugins]]
+name = "bar"
+
+[tool.other]
+a = "b"
+"""
+    doc = parse(content)
+    assert doc.as_string() == content
+    assert doc.unwrap() == {
+        "tool": {"poetry": {"name": "foo"}, "other": {"a": "b"}},
+        "plugins": [{"name": "bar"}],
+    }
+
+
