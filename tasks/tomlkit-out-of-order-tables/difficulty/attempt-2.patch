+    assert a.pop("d") == {"y": 2}
+    a.setdefault("e", [1, 2])
+    _assert_valid_toml_of(
+        doc,
+        {
+            "a": {"c": {"a": 1}, "w": 3, "n": {"t": {"u": 2}}, "e": [1, 2]},
+            "other": {},
+        },
+    )
+
+
+def test_table_added_under_dotted_key_gets_its_own_header() -> None:
+    doc = parse('[c]\na.b = 1\nx = "s"\n')
+    doc["c"]["a"]["t"] = {"u": 2}
+    _assert_valid_toml_of(doc, {"c": {"a": {"b": 1, "t": {"u": 2}}, "x": "s"}})
+
+    doc = parse('[a]\nb.a = []\nc = "s"\n')
+    doc["a"]["b"] = {"t": {"u": 2}}
+    doc["a"]["b"].update({"a": "z"})
+    _assert_valid_toml_of(doc, {"a": {"b": {"t": {"u": 2}, "a": "z"}, "c": "s"}})
+
+
+def test_append_to_array_of_tables_split_by_sub_table() -> None:
+    doc = parse("[[a]]\nq = 1\n[x]\n[a.y]\nz = 2\n")
+    doc["a"].append({"q": 3})
+    doc["a"][0]["y"]["n"] = 5
+    _assert_valid_toml_of(
+        doc, {"a": [{"q": 1, "y": {"z": 2, "n": 5}}, {"q": 3}], "x": {}}
+    )
