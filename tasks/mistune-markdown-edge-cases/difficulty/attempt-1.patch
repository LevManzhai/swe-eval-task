+def _find_directive_end(src: str, pos: int, marker: str, markers: str) -> Optional[Tuple[int, int]]:
+    """Find the closing fence of a directive opened with ``marker``.
+
+    Nested directives (with any fence length) and fenced code blocks inside
+    the content are skipped, so that their closing fences can not close the
+    outer directive. Returns the start and end position of the closing line.
+    """
+    # the rest of the opening line belongs to the directive
+    newline = src.find("\n", pos)
+    if newline == -1:
+        return None
+    pos = newline + 1
+
+    # stack of open fences: (fence char, fence length, is_code)
+    stack: List[Tuple[str, int, bool]] = [(marker[0], len(marker), False)]
+    while pos < len(src):
+        newline = src.find("\n", pos)
+        line_end = len(src) if newline == -1 else newline + 1
+        line = src[pos:line_end].rstrip("\n")
+        m = _fence_line_re.match(line)
+        if m:
+            fence = m.group("fence")
+            info = m.group("info")
+            char, length, is_code = stack[-1]
+            if fence[0] == char and len(fence) >= length and not info.strip(" \t"):
+                stack.pop()
+                if not stack:
+                    return pos, line_end
+            elif not is_code:
+                if fence[0] in markers and _type_re.match(info):
+                    stack.append((fence[0], len(fence), False))
+                elif fence[0] in "`~" and not (fence[0] == "`" and "`" in info):
+                    stack.append((fence[0], len(fence), True))
+        pos = line_end
+    return None
+
