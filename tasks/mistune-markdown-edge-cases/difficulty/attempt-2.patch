+def _find_closing_fence(src: str, pos: int, marker: str, end_re: "re.Pattern[str]") -> Optional["re.Match[str]"]:
+    """Find the fence closing a directive. Directives nested with the same
+    fence character are skipped together with their own closing fence."""
+    c = re.escape(marker[0])
+    open_re = re.compile(r"^ {0,3}(" + c + r"{3,}) *\{[a-zA-Z0-9_-]+\}[^\n]*(?:\n|$)", re.M)
+    close_re = re.compile(r"^ {0,3}(" + c + r"{3,})[ \t]*(?:\n|$)", re.M)
+    stack: List[int] = []
+    while pos < len(src):
+        m = open_re.match(src, pos)
+        if m:
+            stack.append(len(m.group(1)))
+            pos = m.end()
+            continue
+        m2 = close_re.match(src, pos)
+        if m2:
+            size = len(m2.group(1))
+            if stack and size >= stack[-1]:
+                stack.pop()
+            elif not stack and end_re.match(src, pos):
+                return end_re.match(src, pos)
+            pos = m2.end()
+            continue
+        end = src.find("\n", pos)
+        if end < 0:
+            break
+        pos = end + 1
+    return None
+
