diff --git a/src/werkzeug/_internal.py b/src/werkzeug/_internal.py
index 05fc8d5..6e2cc68 100644
--- a/src/werkzeug/_internal.py
+++ b/src/werkzeug/_internal.py
@@ -105,3 +105,68 @@ def _plain_int(value: str, base: t.Literal[10, 16] = 10) -> int:
         raise ValueError(value)
 
     return int(value, base)
+
+
+_plain_uint_re = re.compile(r"[0-9]+", re.ASCII)
+
+
+def _plain_uint(value: str) -> int:
+    """Parse a non-negative int made of only ASCII digits, like the
+    ``1*DIGIT`` grammar in HTTP headers. A sign is not allowed.
+
+    Any surrounding spaces and tabs are stripped.
+    """
+    value = value.strip(" \t")
+
+    if _plain_uint_re.fullmatch(value) is None:
+        raise ValueError(value)
+
+    return int(value)
+
+
+_port_re = re.compile(r"[1-9][0-9]{0,4}", re.ASCII)
+
+
+def _parse_port(value: str) -> int | None:
+    """Parse a TCP port, 1 to 65535 written without leading zeros. Returns
+    ``None`` if the value is not valid.
+    """
+    if _port_re.fullmatch(value) is None:
+        return None
+
+    port = int(value)
+
+    if port > 65535:
+        return None
+
+    return port
+
+
+def _split_host_port(value: str) -> tuple[str, str | None]:
+    """Split a ``host:port`` value into the host and the port string, or
+    ``None`` if there is no port. A bracketed IPv6 literal ``[::1]:8080``
+    is handled, and the brackets are kept on the host.
+    """
+    if value.startswith("["):
+        end = value.find("]")
+
+        if end != -1:
+            host = value[: end + 1]
+            rest = value[end + 1 :]
+
+            if rest.startswith(":"):
+                return host, rest[1:]
+
+            if not rest:
+                return host, None
+
+    host, sep, port = value.rpartition(":")
+
+    if not sep:
+        return value, None
+
+    if ":" in host:
+        # An unbracketed IPv6 address, there is no port.
+        return value, None
+
+    return host, port
