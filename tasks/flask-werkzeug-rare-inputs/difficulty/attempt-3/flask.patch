 import importlib.util
 import os
+import re
 import sys
 import typing as t
 from datetime import datetime
@@ -677,3 +678,49 @@ class _CollectErrors:
         """Raise if any errors were collected."""
         if self.errors:
             raise BaseExceptionGroup(message, self.errors)
+
+
+_port_re = re.compile(r"[1-9][0-9]{0,4}", re.ASCII)
+
+
+def _parse_port(value: str) -> int | None:
+    """Parse a TCP port, 1 to 65535 written with ASCII digits and without
+    leading zeros. Returns ``None`` if the value is not valid.
+    """
+    if _port_re.fullmatch(value) is None:
+        return None
+
+    port = int(value)
+
+    if port > 65535:
+        return None
+
+    return port
+
+
+def _split_host_port(value: str) -> tuple[str, str | None]:
+    """Split a ``host:port`` value into the host and the port string, or
+    ``None`` if there is no port. A bracketed IPv6 literal such as
+    ``[::1]:8080`` is handled, and the brackets are kept on the host. An
+    unbracketed IPv6 address such as ``::1`` is treated as a host without a
+    port.
+    """
+    if value.startswith("["):
+        end = value.find("]")
+
+        if end != -1:
+            host = value[: end + 1]
+            rest = value[end + 1 :]
+
+            if not rest:
+                return host, None
+
+            if rest.startswith(":"):
+                return host, rest[1:]
+
+    host, sep, port = value.rpartition(":")
+
+    if not sep or ":" in host:
+        return value, None
+
+    return host, port
