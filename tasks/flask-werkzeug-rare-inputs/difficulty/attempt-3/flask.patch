+def _check_run_port(port: t.Any) -> int:
+    """Validate the port given to :meth:`Flask.run`. ``0`` lets the OS choose
+    a port, otherwise it must be 1 to 65535. A string must be written with
+    ASCII digits and without leading zeros.
+    """
+    if isinstance(port, str):
+        if port == "0":
+            return 0
+
+        if (value := _parse_port(port)) is None:
+            raise ValueError(f"Invalid port: {port!r}")
+
+        return value
+
+    value = int(port)
+
+    if value != port or not 0 <= value <= 65535:
+        raise ValueError(f"Invalid port: {port!r}")
+
+    return value
