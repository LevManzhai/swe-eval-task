diff --git a/src/flask/helpers.py b/src/flask/helpers.py
index 5073bea..fd2682a 100644
--- a/src/flask/helpers.py
+++ b/src/flask/helpers.py
@@ -677,3 +677,57 @@ class _CollectErrors:
         """Raise if any errors were collected."""
         if self.errors:
             raise BaseExceptionGroup(message, self.errors)
+
+
+def _split_host_port(value: str) -> tuple[str, str | None]:
+    """Split a ``host`` or ``host:port`` value into the host name and the port
+    string, or ``None`` if there is no port. A bracketed IPv6 literal such as
+    ``[::1]:8080`` is returned without brackets. An unbracketed value with
+    more than one colon is treated as an IPv6 literal without a port.
+
+    :meta private:
+    """
+    if value.startswith("["):
+        host, sep, rest = value[1:].partition("]")
+
+        if not sep or (rest and not rest.startswith(":")):
+            raise ValueError(f"Invalid host {value!r}.")
+
+        return host, (rest[1:] if rest else None)
+
+    if value.count(":") > 1:
+        # IPv6 literal without brackets, can't have a port.
+        return value, None
+
+    host, sep, port = value.partition(":")
+    return host, (port if sep else None)
+
+
+def _parse_port(value: str | int, allow_zero: bool = False) -> int:
+    """Parse a TCP port. It must be an integer from 1 to 65535, written with
+    ASCII digits and no leading zeros. If ``allow_zero`` is enabled, ``0`` is
+    also accepted, to bind to any available port.
+
+    :meta private:
+    """
+    if isinstance(value, bool):
+        raise ValueError(f"Invalid port {value!r}.")
+
+    if isinstance(value, int):
+        port = value
+    else:
+        value_str = str(value)
+
+        if not (
+            value_str.isascii()
+            and value_str.isdigit()
+            and (value_str == "0" or not value_str.startswith("0"))
+        ):
+            raise ValueError(f"Invalid port {value!r}.")
+
+        port = int(value_str)
+
+    if not (0 if allow_zero else 1) <= port <= 65535:
+        raise ValueError(f"Invalid port {value!r}.")
+
+    return port
