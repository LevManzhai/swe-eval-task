index 5073bea..b0377c9 100644
--- a/src/flask/helpers.py
+++ b/src/flask/helpers.py
@@ -2,6 +2,7 @@ from __future__ import annotations
 
 import importlib.util
 import os
+import re
 import sys
 import typing as t
 from datetime import datetime
@@ -641,6 +642,59 @@ def get_root_path(import_name: str) -> str:
     return os.path.dirname(os.path.abspath(filepath))  # type: ignore[no-any-return]
 
 
+_port_re = re.compile(r"[1-9][0-9]{0,4}", re.ASCII)
+
+
+def _parse_port(value: str, allow_zero: bool = False) -> int:
+    """Parse a TCP port, a number from 1 to 65535 written with ASCII digits
+    and without leading zeros. Raises ``ValueError`` if it is not valid.
+
+    :param allow_zero: Also allow ``0``, which tells the server to pick a free
+        port.
+    """
+    if allow_zero and value == "0":
+        return 0
+
+    if _port_re.fullmatch(value) is None or int(value) > 65535:
+        raise ValueError(f"Invalid port {value!r}.")
+
+    return int(value)
+
+
+def _split_host_port(
+    value: str, allow_zero: bool = False
+) -> tuple[str, int | None]:
+    """Split a ``host`` or ``host:port`` value into the host and the port, or
+    ``None`` if there is no port. A bracketed IPv6 literal such as
+    ``[::1]:8080`` is supported, the brackets are removed from the returned
+    host. An unbracketed IPv6 address is returned unchanged with no port.
+
+    Raises ``ValueError`` if the port is not valid.
+    """
+    if value.startswith("["):
+        end = value.find("]")
+
+        if end == -1:
+            raise ValueError(f"Invalid host {value!r}.")
+
+        host, rest = value[1:end], value[end + 1 :]
+
+        if not rest:
+            return host, None
+
+        if not rest.startswith(":"):
+            raise ValueError(f"Invalid host {value!r}.")
+
+        return host, _parse_port(rest[1:], allow_zero)
+
+    if value.count(":") != 1 or "://" in value:
+        # No port, an unbracketed IPv6 address, or a "unix://" socket path.
+        return value, None
+
+    host, _, port = value.partition(":")
+    return host, _parse_port(port, allow_zero)
+
+
 @cache
 def _split_blueprint_path(name: str) -> list[str]:
     out: list[str] = [name]
