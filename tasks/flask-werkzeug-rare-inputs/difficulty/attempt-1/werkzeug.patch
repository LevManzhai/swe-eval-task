diff --git a/src/werkzeug/_internal.py b/src/werkzeug/_internal.py
index 05fc8d5..2388eac 100644
--- a/src/werkzeug/_internal.py
+++ b/src/werkzeug/_internal.py
@@ -105,3 +105,69 @@ def _plain_int(value: str, base: t.Literal[10, 16] = 10) -> int:
         raise ValueError(value)
 
     return int(value, base)
+
+
+def _plain_uint(value: str, base: t.Literal[10, 16] = 10) -> int:
+    """Parse a non-negative int only if it is made of valid ASCII digits for the
+    base, like :func:`_plain_int` but without allowing a ``-`` sign.
+
+    Any surrounding spaces and tabs are stripped.
+    """
+    value = value.strip(" \t")
+
+    if value.startswith("-"):
+        raise ValueError(value)
+
+    return _plain_int(value, base)
+
+
+def _split_host_port(value: str) -> tuple[str, str | None]:
+    """Split a ``host:port`` value into the host and the port, or ``None`` if
+    there is no port. A bracketed IPv6 literal is kept bracketed.
+    """
+    if value.startswith("["):
+        end = value.find("]")
+
+        if end != -1:
+            host, rest = value[: end + 1], value[end + 1 :]
+
+            if rest.startswith(":"):
+                return host, rest[1:]
+
+            return host, None
+
+    host, sep, port = value.partition(":")
+    return host, port if sep else None
+
+
+def _find_parameter_delimiter(value: str, pos: int, delimiter: str = ";") -> int:
+    """Find the position after the next delimiter starting at ``pos``, skipping
+    any following spaces. Delimiters inside quoted strings are ignored. Returns
+    ``-1`` if there is no further delimiter, or if a quoted string is not
+    closed, as the text inside it must not be read as further parts.
+    """
+    length = len(value)
+    quote = False
+
+    while pos < length:
+        char = value[pos]
+
+        if quote:
+            if char == "\\":
+                pos += 1
+            elif char == '"':
+                quote = False
+        elif char == '"':
+            quote = True
+        elif char == delimiter:
+            pos += 1
+
+            while pos < length and value[pos] in " \t":
+                pos += 1
+
+            return pos
+
+        pos += 1
+
+    return -1
+
