+class _URLParts(t.NamedTuple):
+    scheme: str
+    has_netloc: bool
+    username: str | None
+    password: str | None
+    hostname: str
+    port: str | None
+    path: str
+    query: str | None
+    fragment: str | None
+
+    def unsplit(
+        self, netloc: str, path: str, query: str | None, fragment: str | None
+    ) -> str:
+        out = []
+
+        if self.scheme:
+            out.append(f"{self.scheme}:")
+
+        if self.has_netloc:
+            out.append(f"//{netloc}")
+
+        out.append(path)
+
+        if self.query is not None:
+            out.append(f"?{query}")
+
+        if self.fragment is not None:
+            out.append(f"#{fragment}")
+
+        return "".join(out)
+
+
+_c0_control_or_space = "".join(map(chr, range(0x21)))
+
+
+def _split_url(url: str) -> _URLParts:
+    """Split a URL into its components like :func:`urllib.parse.urlsplit`, but
+    keep track of components that are present but empty, such as ``?`` with no
+    query, ``#`` with no fragment, ``//`` with no host, an empty password, or an
+    empty port. ``None`` means the component is not present. The port is kept
+    as a string, unchanged.
+    """
+    parts = urlsplit(url)
+    # Repeat the preprocessing done by urlsplit to find which delimiters are
+    # present in the remaining string.
+    rest = url.lstrip(_c0_control_or_space)
+
+    for c in "\t\r\n":
+        rest = rest.replace(c, "")
+
+    if parts.scheme:
+        rest = rest[len(parts.scheme) + 1 :]
+
+    has_netloc = rest.startswith("//")
+
+    if has_netloc:
+        rest = rest[2 + len(parts.netloc) :]
+
+    before_fragment, has_fragment, _ = rest.partition("#")
+    has_query = "?" in before_fragment
+
+    userinfo, has_userinfo, hostport = parts.netloc.rpartition("@")
+    username: str | None = None
+    password: str | None = None
+
+    if has_userinfo:
+        username, has_password, password_str = userinfo.partition(":")
+
+        if has_password:
+            password = password_str
+
+    port: str | None = None
+
+    if hostport.startswith("[") and "]" in hostport:
+        end = hostport.index("]")
+        hostname = hostport[1:end]
+        after = hostport[end + 1 :]
+
+        if after.startswith(":"):
+            port = after[1:]
+    else:
+        hostname, has_port, port_str = hostport.partition(":")
+
+        if has_port:
+            port = port_str
+
+    return _URLParts(
+        scheme=parts.scheme,
+        has_netloc=has_netloc,
+        username=username,
+        password=password,
+        hostname=hostname.lower(),
+        port=port,
+        path=parts.path,
+        query=parts.query if has_query else None,
+        fragment=parts.fragment if has_fragment else None,
+    )
 
 
