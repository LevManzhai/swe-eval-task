--- a/src/croniter/tests/test_croniter.py
+++ b/src/croniter/tests/test_croniter.py
@@ -2871,6 +2871,39 @@ class CroniterTest(base.TestCase):
             efst("H(10-50)/7 * * * *", 0, hash_id="xyz"), efst("10-50/7 * * * *", 0)
         )
 
+    def test_expand_from_start_time_keeps_range_bounds(self):
+        start = datetime(2024, 7, 11, 10, 7)
+
+        def efst(expr, field, start=start):
+            return croniter(expr, start_time=start, expand_from_start_time=True).expanded[field]
+
+        self.assertEqual(efst("* 8-17 * * *", 1, datetime(2026, 1, 1, 7, 7)), list(range(8, 18)))
+        self.assertEqual(efst("10-50/15 * * * *", 0), [22, 37])
+        self.assertEqual(efst("10-20/7 * * * *", 0), [14])
+        self.assertEqual(efst("5/15 * * * *", 0, datetime(2024, 1, 1, 0, 2)), [17, 32, 47])
+        self.assertEqual(efst("45/15 * * * *", 0), [52])
+        self.assertEqual(efst("59/15 * * * *", 0), [59])
+        self.assertEqual(efst("*/60 * * * *", 0, datetime(2024, 1, 1, 0, 59)), [59])
+        self.assertEqual(efst("* * * * MON-FRI", 4), [1, 2, 3, 4, 5])
+        self.assertEqual(efst("* * * * 6-0", 4), [0, 6])
+        self.assertEqual(efst("* * 10-11/2 * *", 2, datetime(2024, 1, 1)), [11])
+        self.assertEqual(efst("1-1/15 * * * *", 0, datetime(2024, 1, 1)), [0, 15, 30, 45])
+        self.assertEqual(efst("0 0 1 1-1/3 *", 3, datetime(2024, 2, 15)), [2, 5, 8, 11])
+        self.assertEqual(efst("0 0 1 */3 *", 3, datetime(2024, 3, 15)), [3, 6, 9, 12])
+        self.assertEqual(efst("0 0 * * */2", 4, datetime(2024, 7, 14)), [0, 2, 4, 6])
+        # The Unix epoch is a start time like any other.
+        self.assertEqual(efst("0 0 * * 2-6/3", 4, datetime(1970, 1, 1)), [4])
+
+    def test_expand_from_start_time_seconds_and_years(self):
+        start = datetime(2024, 1, 1, 0, 0, 7)
+
+        def efst(expr, field):
+            return croniter(expr, start_time=start, expand_from_start_time=True).expanded[field]
+
+        self.assertEqual(efst("* * * * * */15", 5), [7, 22, 37, 52])
+        self.assertEqual(efst("* * * * * * */5", 6)[:3], [1974, 1979, 1984])
+        self.assertEqual(efst("* * * * * * 2030-2040/5", 6), [2034, 2039])
+
